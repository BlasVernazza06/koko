---
import Layout from '@/layouts/Layout.astro';
import TerminalSimulator from '@/components/TerminalSimulator.svelte';
import CopyCommand from '@/components/landing/copyCommand.svelte';
import FeaturesSec from '@/components/landing/featuresSec.astro';
---

<Layout>
  <div class="min-h-screen bg-bg-base text-text-main selection:bg-brand-primary/20 transition-colors duration-300 relative overflow-hidden">
    
    <!-- Ambient brand background glows (Full Page Aura) -->
    <div class="hero-bg-glow">
      <div class="glow-primary"></div>
      <div class="glow-secondary-left"></div>
      <div class="glow-secondary-right"></div>
      <div class="glow-wash"></div>
    </div>

    <!-- Hero Section -->
    <main class="max-w-7xl mx-auto px-6 py-20 md:py-28 flex flex-col items-center justify-center relative z-10">
      
      <!-- Top announcement badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-8 rounded-full bg-bg-surface border border-border-subtle text-xs text-text-muted select-none">
        <span class="flex h-2 w-2 rounded-full bg-brand-primary animate-pulse"></span>
        <span>Claw CLI v0.1.0 is now live</span>
      </div>

      <!-- Heading -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl sm:text-5xl md:text-[64px] font-extrabold tracking-tight leading-[1.1] mb-6 font-sans">
          Scaffold your projects <span class="bg-gradient-to-r from-brand-primary to-brand-secondary bg-clip-text text-transparent">with speed.</span>
        </h1>
        <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl mx-auto">
          Claw is an ultra-fast CLI scaffolding tool built to automate repository setups. Maintain clean, standardized structures across all your engineering teams.
        </p>
      </div>

      <div class="max-w-sm mx-auto my-8 font-sans gap-3 flex flex-col items-center justify-center w-full">
        <a href="#terminal" class="flex items-center justify-center bg-brand-primary hover:bg-brand-primary/95 transition-colors w-full py-4 rounded-xl shadow-lg shadow-brand-primary/10 cursor-pointer">
          <span class="text-white font-semibold">Get Started</span>
        </a>
        <section class="w-full max-w-3xl">
          <CopyCommand client:load />
        </section>
      </div>

      <!-- Svelte Interactive Terminal Simulator -->
      <section id="terminal" class="w-full max-w-5xl">
        <TerminalSimulator client:load />
      </section>

      <!-- Divider line -->
      <div class="w-full max-w-5xl h-px bg-border-subtle my-20"></div>

      <!-- Features Section -->
      <FeaturesSec />

    </main>

    <!-- Footer -->
    <footer class="border-t border-border-subtle py-8 bg-bg-surface/30">
      <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-[12px] text-text-muted">
          © {new Date().getFullYear()} Claw CLI. Powered by Astro, Svelte and Tailwind.
        </div>
        <div class="flex gap-6 text-[12px] text-text-muted">
          <a href="#" class="hover:text-text-main transition-colors">Privacy Policy</a>
          <a href="#" class="hover:text-text-main transition-colors">Terms of Service</a>
        </div>
      </div>
    </footer>

  </div>
</Layout>

<style>
  .hero-bg-glow {
    position: absolute;
    top: 100px;
    left: 0;
    right: 0;
    height: 900px;
    pointer-events: none;
    overflow: hidden;
    user-select: none;
    z-index: 1;
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 40%, transparent 95%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 40%, transparent 95%);
  }
  .glow-primary {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, var(--brand-primary) 0%, transparent 50%);
    opacity: 0.28;
    transition: opacity 0.3s ease;
  }
  .glow-secondary-left {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 5% 0%, var(--brand-secondary) 0%, transparent 40%);
    opacity: 0.18;
    transition: opacity 0.3s ease;
  }
  .glow-secondary-right {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 95% 0%, var(--brand-secondary) 0%, transparent 40%);
    opacity: 0.18;
    transition: opacity 0.3s ease;
  }
  .glow-wash {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 400px;
    background: linear-gradient(to bottom, var(--brand-primary), transparent);
    opacity: 0.04;
  }

  :global([data-theme="dark"]) .glow-primary { opacity: 0.12; }
  :global([data-theme="dark"]) .glow-secondary-left { opacity: 0.08; }
  :global([data-theme="dark"]) .glow-secondary-right { opacity: 0.08; }
  :global([data-theme="dark"]) .glow-wash { opacity: 0.02; }
</style>
