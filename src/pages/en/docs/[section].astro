---
import Layout from '@/layouts/Layout.astro';
import FooterSection from '@/components/sections/footer/FooterSection.astro';
import LeftSidebar from '@/components/docs/LeftSidebar.astro';
import DocContent from '@/components/docs/DocContent.astro';
import RightSidebar from '@/components/docs/RightSidebar.astro';
import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import DustDriftCanvas from '@/components/ui/DustDriftCanvas.astro';
import { docsData } from '@/lib/docsData';

export function getStaticPaths() {
  return docsData.en.map((section) => ({
    params: { section: section.id }
  }));
}

const { section } = Astro.params;
const activeSectionId = section || 'quick-start';
const activeSection = docsData.en.find(s => s.id === activeSectionId) || docsData.en[0];
---

<Layout lang="en" title={`Koko Docs — ${activeSection.title}`} description={`Learn how to scaffold, customize, and optimize your workspaces using Koko. Section: ${activeSection.title}.`}>
  <div class="min-h-[calc(100vh-3.5rem)] bg-bg-base text-text-main flex flex-col relative font-sans">
    
    <!-- Ambient brand background glow & particle drift -->
    <AmbientGlow />
    <DustDriftCanvas />

    <!-- Docs Layout Container (Amplitud optimizada en eje X estilo DevTools) -->
    <div class="max-w-[90rem] xl:max-w-[92rem] mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-1 flex gap-8 xl:gap-12 relative z-10">
      
      <!-- Left Column Sidebar Component -->
      <LeftSidebar sections={docsData.en} activeSectionId={activeSectionId} lang="en" />

      <!-- Center Column Content Component -->
      <DocContent activeSection={activeSection} lang="en" />

      <!-- Right Column Table of Contents Outline Component -->
      <RightSidebar activeSection={activeSection} lang="en" />

    </div>

    <!-- Footer -->
    <FooterSection lang="en" />

  </div>
</Layout>
