---
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/footer/footer.astro';
import { Cpu, Layers, ShieldCheck, Settings, ArrowLeft, ArrowRight, HelpCircle, Terminal, ChevronDown } from "@lucide/svelte";
---

<Layout lang="es" title="Koko Docs — Documentación Oficial" description="Aprende cómo estructurar, customizar y optimizar tus proyectos usando Koko.">
  <div class="min-h-screen bg-bg-base text-text-main flex flex-col relative font-sans">
    
    <!-- Header visual background line / alignment -->
    <div class="absolute top-0 left-0 right-0 h-px bg-border-subtle/50 z-20"></div>

    <!-- Docs Layout Container -->
    <div class="max-w-7xl mx-auto w-full px-6 py-10 flex-1 flex gap-10 relative">
      
      <!-- Left Sidebar (Docs Navigation Menu) -->
      <aside class="w-60 shrink-0 hidden lg:block sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto select-none pr-4 scrollbar-thin text-sm">
        
        <!-- Top Tech Icons Matching Reference -->
        <div class="grid grid-cols-4 gap-2 mb-6">
          <div class="w-10 h-10 rounded-lg bg-bg-surface border border-border-subtle flex items-center justify-center text-emerald-500 font-bold text-sm shadow-xs">N</div>
          <div class="w-10 h-10 rounded-lg bg-bg-surface border border-border-subtle flex items-center justify-center text-text-main font-bold text-sm shadow-xs">C</div>
          <div class="w-10 h-10 rounded-lg bg-bg-surface border border-border-subtle flex items-center justify-center text-blue-400 font-bold text-sm shadow-xs">E</div>
          <div class="w-10 h-10 rounded-lg bg-bg-surface border border-border-subtle flex items-center justify-center text-amber-500 font-bold text-sm shadow-xs">D</div>
        </div>

        <div class="space-y-6">
          <!-- Quick Start Item -->
          <div>
            <a 
              href="#overview" 
              class="flex items-center px-3 py-2 rounded-lg bg-brand-primary/10 text-brand-primary font-bold text-xs transition-all tracking-wide shadow-xs border border-brand-primary/20"
            >
              Inicio Rápido
            </a>
          </div>

          <!-- CLI Group -->
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold text-text-muted hover:text-text-main cursor-pointer px-2 py-1">
              <span>CLI</span>
              <ChevronDown size={12} class="opacity-70" />
            </div>
            <ul class="space-y-1 pl-3 border-l border-border-subtle/60 ml-2">
              <li>
                <a href="#getting-started" class="block text-xs text-text-muted hover:text-brand-primary py-1.5 transition-colors font-medium">
                  Primeros Pasos
                </a>
              </li>
              <li>
                <a href="#scaffolding" class="block text-xs text-text-muted hover:text-brand-primary py-1.5 transition-colors">
                  Estructuración Interactiva
                </a>
              </li>
              <li>
                <a href="#presets" class="block text-xs text-text-muted hover:text-brand-primary py-1.5 transition-colors">
                  Recetas y Presets Activos
                </a>
              </li>
            </ul>
          </div>

          <!-- Core Features Group -->
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold text-text-muted hover:text-text-main cursor-pointer px-2 py-1">
              <span>Características</span>
              <ChevronDown size={12} class="opacity-70" />
            </div>
            <ul class="space-y-1 pl-3 border-l border-border-subtle/60 ml-2">
              <li>
                <a href="#drift" class="block text-xs text-text-muted hover:text-brand-primary py-1.5 transition-colors">
                  Control de Desviación
                </a>
              </li>
              <li>
                <a href="#offline" class="block text-xs text-text-muted hover:text-brand-primary py-1.5 transition-colors">
                  Motor sin Dependencias
                </a>
              </li>
            </ul>
          </div>

          <!-- Configuration Group -->
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold text-text-muted hover:text-text-main cursor-pointer px-2 py-1">
              <span>Avanzado</span>
              <ChevronDown size={12} class="opacity-70" />
            </div>
            <ul class="space-y-1 pl-3 border-l border-border-subtle/60 ml-2">
              <li>
                <a href="#configuration" class="block text-xs text-text-muted hover:text-brand-primary py-1.5 transition-colors">
                  koko.json Specs
                </a>
              </li>
            </ul>
          </div>

        </div>
      </aside>

      <!-- Center Content Area -->
      <main class="flex-1 min-w-0 max-w-3xl pb-20">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-text-muted mb-4 font-mono select-none">
          <span>Docs</span>
          <span>/</span>
          <span>Introducción</span>
          <span>/</span>
          <span class="text-brand-primary">Inicio Rápido</span>
        </nav>

        <!-- Main Header -->
        <div id="overview" class="space-y-4 mb-10 scroll-mt-28">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-primary">Overview</span>
          <h1 class="text-4xl font-extrabold tracking-tight text-text-main font-sans">Koko Scaffolder</h1>
          <p class="text-base text-text-muted leading-relaxed">
            Koko es un motor de inicialización y control arquitectónico para desarrolladores exigentes. Te permite desplegar plantillas limpias, linters configurados y dockerización modular en segundos.
          </p>
        </div>

        <!-- CLI Installation Commands -->
        <div class="space-y-6 mb-12">
          <h3 class="text-lg font-bold text-text-main">Prerrequisitos</h3>
          <ul class="list-disc pl-5 text-sm text-text-muted space-y-2 leading-relaxed">
            <li><strong>Node.js LTS</strong> - Descargable desde nodejs.org</li>
            <li><strong>Git (opcional)</strong> - Si deseas inicializar repositorios de forma automática</li>
            <li><strong>Bun (opcional)</strong> - Descargable desde bun.sh si deseas usar Bun como manejador de paquetes</li>
          </ul>
        </div>

        <!-- Section content items -->
        <div class="space-y-16">
          
          <!-- Getting Started -->
          <section id="getting-started" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl font-bold tracking-tight text-text-main border-b border-border-subtle/60 pb-2">Instalación Inicial</h2>
            <p class="text-sm text-text-muted leading-relaxed">
              Ejecuta el asistente interactivo de inicialización directamente usando tu gestor de paquetes favorito:
            </p>
            <div class="rounded-xl border border-border-subtle bg-bg-surface overflow-hidden shadow-xs">
              <div class="flex items-center justify-between px-4 py-2 bg-bg-base/60 border-b border-border-subtle text-xs text-text-muted">
                <div class="flex gap-4">
                  <span class="text-brand-primary font-bold">npm</span>
                  <span>pnpm</span>
                  <span>yarn</span>
                  <span>bun</span>
                </div>
                <span>Terminal</span>
              </div>
              <div class="p-4 font-mono text-xs flex justify-between items-center text-brand-primary">
                <span>npm create koko-app@latest</span>
                <button class="px-2.5 py-1 bg-bg-base border border-border-subtle rounded-md hover:border-brand-primary/40 text-[10px] text-text-muted hover:text-text-main font-bold select-none cursor-pointer">Copiar</button>
              </div>
            </div>
          </section>

          <!-- Scaffolding -->
          <section id="scaffolding" class="scroll-mt-28 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand-primary/10 border border-brand-primary/20 flex items-center justify-center text-brand-primary shrink-0">
                <Cpu size={16} />
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-text-main">Estructuración Interactiva</h2>
            </div>
            <p class="text-sm text-text-muted leading-relaxed">
              El motor de terminal lee tus respuestas y genera la estructura modular idónea. Configura bases de datos, TypeScript, y variables de entorno sin perder consistencia en tu equipo de desarrollo.
            </p>
            <div class="rounded-xl border border-border-subtle bg-bg-surface overflow-hidden shadow-xs">
              <div class="flex items-center justify-between px-4 py-2 bg-bg-base/60 border-b border-border-subtle text-xs text-text-muted">
                <span>Instalación Automática sin Prompt</span>
              </div>
              <div class="p-4 font-mono text-xs flex justify-between items-center text-brand-primary">
                <span>npm create koko-app@latest --yes</span>
                <button class="px-2.5 py-1 bg-bg-base border border-border-subtle rounded-md hover:border-brand-primary/40 text-[10px] text-text-muted hover:text-text-main font-bold select-none cursor-pointer">Copiar</button>
              </div>
            </div>
          </section>

          <!-- Presets -->
          <section id="presets" class="scroll-mt-28 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand-primary/10 border border-brand-primary/20 flex items-center justify-center text-brand-primary shrink-0">
                <Layers size={16} />
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-text-main">Recetas y Presets Activos</h2>
            </div>
            <p class="text-sm text-text-muted leading-relaxed">
              Ahorra tiempo aplicando blueprints estructurados para arquitecturas conocidas. Soporta setups optimizados para React, Next.js, FastAPI, y monorepos vacíos.
            </p>
          </section>

          <!-- Drift Prevention -->
          <section id="drift" class="scroll-mt-28 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand-primary/10 border border-brand-primary/20 flex items-center justify-center text-brand-primary shrink-0">
                <ShieldCheck size={16} />
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-text-main">Control de Desviación (Drift)</h2>
            </div>
            <p class="text-sm text-text-muted leading-relaxed">
              Koko se asegura de que nadie rompa la estructura base del repositorio del equipo de forma silenciosa. Compara linters y librerías clave informándote de diferencias de inmediato.
            </p>
          </section>

          <!-- Offline Capabilities -->
          <section id="offline" class="scroll-mt-28 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand-primary/10 border border-brand-primary/20 flex items-center justify-center text-brand-primary shrink-0">
                <Settings size={16} />
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-text-main">Motor sin Dependencias</h2>
            </div>
            <p class="text-sm text-text-muted leading-relaxed">
              El núcleo CLI de Koko es un ejecutable ultra optimizado y compilado en Go nativo, listo para funcionar de inmediato sin inicializaciones complejas.
            </p>
          </section>

          <!-- Advanced Configuration -->
          <section id="configuration" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl font-bold tracking-tight text-text-main border-b border-border-subtle/60 pb-2">Archivo koko.json</h2>
            <p class="text-sm text-text-muted leading-relaxed">
              Define y guarda todos tus parámetros de control arquitectónicos preferidos dentro del manifiesto del proyecto:
            </p>
            <pre class="bg-bg-surface border border-border-subtle p-4 rounded-xl text-xs font-mono text-text-main overflow-x-auto">&#123;
  "name": "koko-workspace",
  "driftPrevention": true,
  "blueprints": ["node-basic", "docker-compose"],
  "rules": &#123;
    "linter": "eslint-strict",
    "docker": "required"
  &#125;
&#125;</pre>
          </section>

        </div>

      </main>

      <!-- Right Sidebar (On This Page Table of Contents) -->
      <aside class="w-56 shrink-0 hidden xl:block sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto select-none pl-5 border-l border-border-subtle/50 text-xs">
        <h5 class="text-xs font-bold uppercase tracking-wider text-text-main mb-4 flex items-center gap-1.5">
          <HelpCircle size={12} />
          En esta página
        </h5>
        
        <!-- Visual timeline list style matching reference upload -->
        <ul class="relative border-l-2 border-border-subtle/60 space-y-4 pl-4 text-xs text-text-muted" id="toc-list">
          
          <li class="relative">
            <!-- Left accent active state block indicator -->
            <div class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full border border-brand-primary bg-bg-base"></div>
            <a href="#overview" class="hover:text-brand-primary block transition-colors font-bold text-brand-primary">
              Filosofía General
            </a>
          </li>

          <li class="relative">
            <div class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full border border-transparent bg-border-subtle/60"></div>
            <a href="#getting-started" class="hover:text-brand-primary block transition-colors font-medium">
              Primeros Pasos
            </a>
            
            <ul class="mt-2 pl-3 space-y-2 border-l border-border-subtle/40 text-[11px]">
              <li><a href="#getting-started" class="hover:text-brand-primary block transition-colors">Prerrequisitos</a></li>
              <li><a href="#scaffolding" class="hover:text-brand-primary block transition-colors">CLI interactivo</a></li>
            </ul>
          </li>

          <li class="relative">
            <div class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full border border-transparent bg-border-subtle/60"></div>
            <a href="#presets" class="hover:text-brand-primary block transition-colors">
              Configuraciones Comunes
            </a>
            
            <ul class="mt-2 pl-3 space-y-2 border-l border-border-subtle/40 text-[11px]">
              <li><a href="#presets" class="hover:text-brand-primary block transition-colors">React + Clerk</a></li>
              <li><a href="#presets" class="hover:text-brand-primary block transition-colors">Expo Apps</a></li>
            </ul>
          </li>

          <li class="relative">
            <div class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full border border-transparent bg-border-subtle/60"></div>
            <a href="#drift" class="hover:text-brand-primary block transition-colors">
              Control de Desvíos
            </a>
          </li>

          <li class="relative">
            <div class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full border border-transparent bg-border-subtle/60"></div>
            <a href="#configuration" class="hover:text-brand-primary block transition-colors">
              Archivo koko.json
            </a>
          </li>

        </ul>
      </aside>

    </div>

    <!-- Footer -->
    <Footer />

  </div>
</Layout>

<script>
  // Simple interaction for Docs Sidebar Active states and smooth scrolling highlighter
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section, main > div[id]');
    const asideLinks = document.querySelectorAll('aside a');

    // Smooth Scroll on hash link click
    asideLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          e.preventDefault();
          const target = document.querySelector(href);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', href);
          }
        }
      });
    });

    // Observer to set highlight states dynamically
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -60% 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          if (!id) return;

          // Find matches
          asideLinks.forEach(link => {
            const href = link.getAttribute('href');
            
            // Left menu highlight
            if (href === `#${id}`) {
              link.classList.add('text-brand-primary', 'font-bold');
              link.classList.remove('text-text-muted');
              
              const containerLi = link.closest('li');
              if (containerLi) {
                const bullet = containerLi.querySelector('.absolute');
                if (bullet) {
                  bullet.classList.add('border-brand-primary', 'bg-bg-base');
                  bullet.classList.remove('border-transparent', 'bg-border-subtle/60');
                }
              }
            } else if (href && href.endsWith(`#${id}`)) {
              // Right menu Highlight
              link.classList.add('text-brand-primary', 'font-bold');
              link.classList.remove('text-text-muted');
              
              const containerLi = link.closest('li');
              if (containerLi) {
                const bullet = containerLi.querySelector('.absolute');
                if (bullet) {
                  bullet.classList.add('border-brand-primary', 'bg-bg-base');
                  bullet.classList.remove('border-transparent', 'bg-border-subtle/60');
                }
              }
            } else {
              link.classList.remove('text-brand-primary', 'font-bold');
              
              const containerLi = link.closest('li');
              if (containerLi) {
                const bullet = containerLi.closest('li')?.querySelector('.absolute');
                if (bullet && !containerLi.querySelector('a')?.classList.contains('text-brand-primary')) {
                  bullet.classList.remove('border-brand-primary', 'bg-bg-base');
                  bullet.classList.add('border-transparent', 'bg-border-subtle/60');
                }
              }
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  });
</script>
