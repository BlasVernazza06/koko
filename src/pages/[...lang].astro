---
import Layout from '@/layouts/Layout.astro';
import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import HeroSection from '@/components/sections/hero/HeroSection.astro';
import TerminalSimulatorSection from '@/components/sections/terminal/TerminalSimulatorSection.astro';
import FeaturesSection from '@/components/sections/features/FeaturesSection.astro';
import FaqSection from '@/components/sections/faq/FaqSection.astro';
import DocsSection from '@/components/sections/docs/DocsSection.astro';
import FooterSection from '@/components/sections/footer/FooterSection.astro';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // Resolves to /
    { params: { lang: 'en' } }       // Resolves to /en
  ];
}

const { lang } = Astro.params;
const currentLang = lang || 'es';

const title = currentLang === 'es' 
  ? 'Koko — Motor de Inicialización de Proyectos Go-Native' 
  : 'Koko — Go-Native Project Scaffolding Engine';

const description = currentLang === 'es'
  ? 'Inicializa proyectos listos para producción en menos de 5 segundos. Koko es un CLI escrito en Go nativo que inyecta dependencias, Docker, y ORM de manera modular.'
  : 'Bootstrap production-ready environments in under 5 seconds. Koko is a native Go CLI that modularly injects dependencies, Docker, and ORMs.';
---

<Layout lang={currentLang} title={title} description={description} revealHeaderOnScroll={false}>
  <div class="min-h-screen bg-bg-base text-text-main selection:bg-brand-primary/20 relative overflow-hidden">
    
    <!-- Ambient brand background glows (Full Page Aura) -->
    <AmbientGlow />

    <!-- Hero Section -->
    <HeroSection lang={currentLang} />

    <!-- Terminal Simulator Section -->
    <TerminalSimulatorSection lang={currentLang} />

    <!-- Features Section -->
    <FeaturesSection lang={currentLang} />

    <!-- FAQ Section -->
    <FaqSection lang={currentLang} />

    <!-- Docs Section -->
    <DocsSection lang={currentLang} />

    <!-- Footer -->
    <FooterSection lang={currentLang} />

  </div>
</Layout>


<script>
  let scrollObserverCleanup: (() => void) | null = null;

  function setupScrollReveals() {
    if (scrollObserverCleanup) {
      scrollObserverCleanup();
      scrollObserverCleanup = null;
    }

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealElements = document.querySelectorAll<HTMLElement>('.scroll-reveal');
    const childContainers = document.querySelectorAll<HTMLElement>('.scroll-reveal-children');

    const allTargets: HTMLElement[] = [];

    // Process standalone reveal elements (skip hero/header)
    revealElements.forEach((el) => {
      if (el.closest('#hero') || el.closest('header')) {
        el.classList.add('is-visible');
        return;
      }
      allTargets.push(el);
    });

    // Process container children with staggered delays
    childContainers.forEach((container) => {
      if (container.closest('#hero') || container.closest('header')) return;
      const children = Array.from(container.children) as HTMLElement[];
      children.forEach((child, idx) => {
        child.classList.add('scroll-reveal-child');
        if (!isReducedMotion) {
          const delayMs = Math.min(idx * 45, 220);
          child.style.transitionDelay = `${delayMs}ms`;
        }
        allTargets.push(child);
      });
    });

    if (allTargets.length === 0) return;

    // Reduced motion: reveal all immediately
    if (isReducedMotion) {
      allTargets.forEach((el) => {
        el.classList.remove('is-exited-up', 'is-exited-down');
        el.classList.add('is-visible');
      });
      return;
    }

    const windowHeight = window.innerHeight;

    // Initial check: if element is already within viewport on page load
    allTargets.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < windowHeight - 30 && rect.bottom > 30) {
        el.classList.remove('is-exited-up', 'is-exited-down');
        el.classList.add('is-visible');
      } else if (rect.top >= windowHeight - 30) {
        el.classList.remove('is-visible', 'is-exited-up');
        el.classList.add('is-exited-down');
      } else {
        el.classList.remove('is-visible', 'is-exited-down');
        el.classList.add('is-exited-up');
      }
    });

    // Continuous bidirectional IntersectionObserver for appearance & disappearance
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const target = entry.target as HTMLElement;
          const rect = entry.boundingClientRect;
          const rootBounds = entry.rootBounds;
          const viewHeight = rootBounds ? rootBounds.height : window.innerHeight;

          if (entry.isIntersecting) {
            // Element enters viewport: reveal smoothly
            target.classList.remove('is-exited-up', 'is-exited-down');
            target.classList.add('is-visible');
          } else {
            // Element leaves viewport: harmoniously disappear based on scroll direction
            target.classList.remove('is-visible');
            if (rect.top <= 40) {
              // Exited through the top
              target.classList.remove('is-exited-down');
              target.classList.add('is-exited-up');
            } else if (rect.bottom >= viewHeight - 40) {
              // Exited through the bottom
              target.classList.remove('is-exited-up');
              target.classList.add('is-exited-down');
            }
          }
        });
      },
      {
        rootMargin: '10px 0px -20px 0px',
        threshold: [0, 0.08]
      }
    );

    allTargets.forEach((el) => observer.observe(el));

    scrollObserverCleanup = () => {
      observer.disconnect();
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupScrollReveals);
  } else {
    setupScrollReveals();
  }

  document.addEventListener('astro:page-load', setupScrollReveals);
  document.addEventListener('astro:after-swap', setupScrollReveals);
</script>
