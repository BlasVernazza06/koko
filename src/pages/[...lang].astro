---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/hero/hero.astro';
import Footer from '@/components/footer/footer.astro';
import TerminalSimulator from '@/components/TerminalSimulator.svelte';
import FeaturesSec from '@/components/landing/feature/featuresSec.astro';
import FaqSec from '@/components/landing/faq/faqSec.astro';
import DocsSec from '@/components/landing/docsSec.astro';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // Resolves to /
    { params: { lang: 'en' } }       // Resolves to /en
  ];
}

const { lang } = Astro.params;
const currentLang = lang || 'es';

const title = currentLang === 'es' 
  ? 'Koko — Motor de Inicialización de Proyectos Go-Native' 
  : 'Koko — Go-Native Project Scaffolding Engine';

const description = currentLang === 'es'
  ? 'Inicializa proyectos listos para producción en menos de 5 segundos. Koko es un CLI escrito en Go nativo que inyecta dependencias, Docker, y ORM de manera modular.'
  : 'Bootstrap production-ready environments in under 5 seconds. Koko is a native Go CLI that modularly injects dependencies, Docker, and ORMs.';
---

<Layout lang={currentLang} title={title} description={description}>
  <div class="min-h-screen bg-bg-base text-text-main selection:bg-brand-primary/20 transition-colors duration-300 relative overflow-hidden">
    
    <!-- Ambient brand background glows (Full Page Aura) -->
    <div class="hero-bg-glow">
      <div class="glow-primary"></div>
      <div class="glow-secondary-left"></div>
      <div class="glow-secondary-right"></div>
      <div class="glow-wash"></div>
    </div>

    <!-- Hero Section -->
    <Hero lang={currentLang} />

    <!-- Terminal Simulator Section -->
    <div class="max-w-7xl mx-auto px-6 flex flex-col items-center justify-center relative z-10">
      <section id="terminal" class="w-full max-w-[1300px]">
        <TerminalSimulator client:load lang={currentLang} />
      </section>
      <div class="w-full max-w-5xl h-px bg-border-subtle my-20"></div>
    </div>

    <!-- Features Section -->
    <FeaturesSec lang={currentLang} />

    <!-- FAQ Section -->
    <FaqSec lang={currentLang} />

    <!-- Docs Section -->
    <DocsSec lang={currentLang} />

    <!-- Footer -->
    <Footer />

  </div>
</Layout>

<style>
  .hero-bg-glow {
    position: absolute;
    top: 100px;
    left: 0;
    right: 0;
    height: 900px;
    pointer-events: none;
    overflow: hidden;
    user-select: none;
    z-index: 1;
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 40%, transparent 95%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 40%, transparent 95%);
  }
  .glow-primary {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, var(--brand-primary) 0%, transparent 50%);
    opacity: 0.28;
    transition: opacity 0.3s ease;
  }
  .glow-secondary-left {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 5% 0%, var(--brand-secondary) 0%, transparent 40%);
    opacity: 0.18;
    transition: opacity 0.3s ease;
  }
  .glow-secondary-right {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 95% 0%, var(--brand-secondary) 0%, transparent 40%);
    opacity: 0.18;
    transition: opacity 0.3s ease;
  }
  .glow-wash {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 400px;
    background: linear-gradient(to bottom, var(--brand-primary), transparent);
    opacity: 0.04;
  }

  :global([data-theme="dark"]) .glow-primary { opacity: 0.12; }
  :global([data-theme="dark"]) .glow-secondary-left { opacity: 0.08; }
  :global([data-theme="dark"]) .glow-secondary-right { opacity: 0.08; }
  :global([data-theme="dark"]) .glow-wash { opacity: 0.02; }
</style>

<script>
  import { animate } from "motion";

  let scrollListenerCleanup: (() => void) | null = null;

  function setupScrollReveals() {
    try {
      // Clean up previous listeners if any
      if (scrollListenerCleanup) {
        scrollListenerCleanup();
      }

      const mainSections = document.querySelectorAll('.scroll-reveal');
      const gridItems = document.querySelectorAll('.scroll-reveal-children > *, .faq-item');
      
      const allElements: Array<{
        el: HTMLElement;
        isMain: boolean;
        delay: number;
        animated: boolean;
      }> = [];
      
      // Initialize main sections
      mainSections.forEach(el => {
        const htmlEl = el as HTMLElement;
        htmlEl.setAttribute('style', 'opacity: 0; transform: translateY(35px) scale(0.98); filter: blur(5px);');
        allElements.push({
          el: htmlEl,
          isMain: true,
          delay: 0,
          animated: false
        });
      });
      
      // Initialize staggered grid/list items
      gridItems.forEach(el => {
        if (el.closest('#hero') || el.closest('header') || el.closest('footer')) return;
        
        const htmlEl = el as HTMLElement;
        const siblings = Array.from(htmlEl.parentNode?.children || []);
        const idx = siblings.indexOf(htmlEl);
        const delay = Math.min((idx >= 0 ? idx : 0) * 0.05, 0.25);
        
        htmlEl.setAttribute('style', 'opacity: 0; transform: translateY(20px) scale(0.99); filter: blur(4px);');
        allElements.push({
          el: htmlEl,
          isMain: false,
          delay,
          animated: false
        });
      });
      
      function handleScroll() {
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        const vh = window.innerHeight;
        
        allElements.forEach(item => {
          const el = item.el;
          const rect = el.getBoundingClientRect();
          // Absolute top coordinate of the element relative to the document
          const elementTop = rect.top + scrollY;
          
          // Trigger animation when the element's top is 90% down the viewport (10% has entered)
          const triggerPoint = elementTop - vh * 0.9;
          
          if (scrollY > triggerPoint) {
            if (!item.animated) {
              item.animated = true;
              animate(
                el,
                { opacity: 1, y: 0, scale: 1, filter: "blur(0px)" },
                { 
                  duration: item.isMain ? 0.75 : 0.6, 
                  delay: item.delay, 
                  easing: [0.16, 1, 0.3, 1] 
                }
              );
            }
          } else {
            // Reset to initial state when scrolled back up
            if (item.animated) {
              item.animated = false;
              animate(
                el,
                { 
                  opacity: 0, 
                  y: item.isMain ? 35 : 20, 
                  scale: item.isMain ? 0.98 : 0.99, 
                  filter: item.isMain ? "blur(5px)" : "blur(4px)" 
                },
                { duration: 0.25 }
              );
            }
          }
        });
      }
      
      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('resize', handleScroll);
      
      // Initial check
      handleScroll();
      
      // Cleanup handler
      scrollListenerCleanup = () => {
        window.removeEventListener('scroll', handleScroll);
        window.removeEventListener('resize', handleScroll);
      };
    } catch (e) {
      console.error("Scroll reveal error:", e);
      // Fallback
      document.querySelectorAll('.scroll-reveal, .scroll-reveal-children > *, .faq-item').forEach(el => {
        el.removeAttribute('style');
      });
    }
  }

  // Ensure DOM is fully loaded and styles parsed before running Motion
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupScrollReveals);
  } else {
    setupScrollReveals();
  }

  document.addEventListener('astro:after-swap', setupScrollReveals);
</script>
