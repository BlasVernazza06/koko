---
import Layout from '@/layouts/Layout.astro';
import FooterSection from '@/components/sections/footer/FooterSection.astro';
import LeftSidebar from '@/components/docs/LeftSidebar.astro';
import DocContent from '@/components/docs/DocContent.astro';
import RightSidebar from '@/components/docs/RightSidebar.astro';
import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import DustDriftCanvas from '@/components/ui/DustDriftCanvas.astro';
import { docsData } from '@/lib/docsData';

export function getStaticPaths() {
  return docsData.es.map((section) => ({
    params: { section: section.id }
  }));
}

const { section } = Astro.params;
const activeSectionId = section || 'quick-start';
const activeSection = docsData.es.find(s => s.id === activeSectionId) || docsData.es[0];
---

<Layout lang="es" title={`Koko Docs — ${activeSection.title}`} description={`Aprende cómo estructurar, configurar y optimizar tus proyectos usando Koko. Sección: ${activeSection.title}.`}>
  <div class="min-h-[calc(100vh-3.5rem)] bg-bg-base text-text-main flex flex-col relative font-sans">
    
    
    <DustDriftCanvas />

    <!-- Docs Layout Container -->
    <div class="max-w-7xl mx-auto w-full px-6 py-8 flex-1 flex gap-10 relative z-10">
      
      <!-- Left Column Sidebar Component -->
      <LeftSidebar sections={docsData.es} activeSectionId={activeSectionId} lang="es" />

      <!-- Center Column Content Component -->
      <DocContent activeSection={activeSection} lang="es" />

      <!-- Right Column Table of Contents Outline Component -->
      <RightSidebar activeSection={activeSection} lang="es" />

    </div>

    <!-- Footer -->
    <FooterSection lang="es" />

  </div>
</Layout>
