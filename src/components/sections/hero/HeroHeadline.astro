---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`text-center max-w-4xl mx-auto mb-3 sm:mb-4 animate-fade-in-up animation-delay-100 ${className}`}>
  <!-- SpaceFS High-Contrast Clamp Headline -->
  <h1 class="text-[clamp(34px,5vw,64px)] leading-[1.04] tracking-[-0.035em] text-balance font-medium mb-3 sm:mb-3.5 font-sans">
    <span class="lang-es">
      <span class="block text-text-main font-bold">Crea tu App...</span>
      <span class="block text-text-muted font-normal mt-1 sm:mt-1.5">
        <span class="text-primary font-medium">Y olvídate de configurarla</span>
      </span>
    </span>
    <span class="lang-en">
      <span class="block text-text-main font-semibold">From zero to production.</span>
      <span class="block text-text-muted font-normal mt-1 sm:mt-1.5">
        <span class="bg-gradient-to-r from-brand-primary via-brand-secondary to-text-main bg-clip-text text-transparent font-medium">In less than 5 seconds.</span>
      </span>
    </span>
  </h1>

  <!-- Koko Concise Subtitle -->
  <p class="max-w-[24rem] sm:max-w-[28rem] text-base sm:text-[17px] text-text-muted leading-relaxed text-pretty mx-auto font-sans font-normal">
    <span class="lang-es">Motor de scaffolding nativo en Go para crear, evolucionar y blindar proyectos modernos sin drift de estándares.</span>
    <span class="lang-en">Native Go scaffolding engine to build, evolve, and protect modern projects with zero standard drift.</span>
  </p>
</div>
