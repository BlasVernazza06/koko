---
import { SvglGoLogo } from '@selemondev/svgl-svelte';
import PillBadge from '@/components/ui/PillBadge.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<PillBadge class={`mb-10 animate-fade-in-up ${className}`}>
  <!-- Pulsing live indicator -->
  <span class="relative flex h-2 w-2 mr-1">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
  </span>

  <!-- Announcement text -->
  <span class="text-xs font-semibold text-text-main flex items-center gap-1.5">
    <span class="lang-es">Koko CLI v1.0.0 disponible</span>
    <span class="lang-en">Koko CLI v1.0.0 is live</span>
  </span>

  <!-- Divider line -->
  <span class="w-px h-3.5 bg-border-subtle/80"></span>

  <!-- Tech logo -->
  <div class="flex items-center gap-1.5">
    <span class="lang-es text-[11px] text-text-muted">Desarrollado con</span>
    <span class="lang-en text-[11px] text-text-muted">Powered by</span>
    <SvglGoLogo width={36} height={14} class="text-[#00ADD8] fill-current [&_g]:fill-current align-middle relative bottom-[1px]" />
  </div>
</PillBadge>
