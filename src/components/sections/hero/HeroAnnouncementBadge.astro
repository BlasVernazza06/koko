---
import { Sparkles } from '@lucide/svelte';
import { SvglGoLogo } from '@selemondev/svgl-svelte';
import PillBadge from '@/components/ui/PillBadge.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<PillBadge class={`mb-5 sm:mb-6 animate-fade-in-up ${className}`}>

  <!-- Announcement text -->
  <span class="text-xs font-semibold text-text-main flex items-center gap-1.5 font-sans">
    <span class="lang-es">Koko v1.0 disponible</span>
    <span class="lang-en">Koko v1.0 live</span>
  </span>

  <!-- Divider line -->
  <span class="w-px h-3.5 bg-badge-border"></span>

  <!-- Tech engine tag -->
  <div class="flex items-center gap-1.5">
    <span class="text-[11px] text-text-muted lang-es">Desarrollado en</span>
    <span class="text-[11px] text-text-muted font-mono lang-en">Developed in</span>
    <SvglGoLogo width={30} height={12} class="text-[#00ADD8] fill-current [&_g]:fill-current align-middle relative bottom-[0.5px]" />
  </div>
</PillBadge>
