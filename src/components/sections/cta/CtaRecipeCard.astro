---
import type { CtaBlueprint } from '@/types/cta.types';

interface Props {
  blueprint: CtaBlueprint;
  langPrefix?: string;
  index?: number;
}

const { blueprint, langPrefix = '', index = 0 } = Astro.props;
const link = `${langPrefix}/builder?recipe=${blueprint.recipeId || blueprint.id}`;
---

<a 
  href={link}
  class={`relative group/card transition-all duration-300 antialiased hover:scale-110 hover:z-30 hover:rotate-0 cursor-pointer block ${blueprint.rotate} ${blueprint.hiddenOnMobile ? 'hidden sm:block' : 'block'}`}
  style={`transition-delay: ${index * 30}ms;`}
  aria-label={blueprint.title}
>
  <div class={`w-[115px] sm:w-[138px] md:w-[154px] rounded-2xl border bg-bg-surface p-3.5 sm:p-4 shadow-sm hover:shadow-xl flex flex-col justify-between h-[135px] sm:h-[155px] md:h-[168px] relative overflow-hidden transition-all duration-200 ${blueprint.accentColor}`}>
    
    <!-- Top Micro Tag -->
    <div class="w-full flex items-center justify-end">
      <span class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-border-subtle/60 bg-bg-base/70 text-text-muted">
        {blueprint.tag}
      </span>
    </div>

    <!-- Centered Hero Stack Logo (Direct <img> without wrapper div, prominent size) -->
    <img 
      src={blueprint.logo} 
      alt={blueprint.title} 
      class="w-10 h-10 sm:w-12 sm:h-12 md:w-13 md:h-13 object-contain mx-auto my-auto group-hover/card:scale-110 transition-transform duration-300 drop-shadow-sm select-none" 
    />

    <!-- Bottom Card Copy -->
    <div class="flex flex-col gap-0.5 mt-auto">
      <h4 class="text-xs sm:text-[13px] font-bold text-text-main leading-tight line-clamp-1">
        {blueprint.title}
      </h4>
      <p class="text-[10px] font-mono text-text-muted leading-tight line-clamp-1">
        <span class="lang-es">{blueprint.metaEs}</span>
        <span class="lang-en">{blueprint.metaEn}</span>
      </p>
    </div>
  </div>
</a>
