---
interface Props {
  lang?: string;
}

const { lang: _lang = 'es' } = Astro.props;
---

<div class="md:col-span-2 group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-border-subtle bg-bg-surface/40 backdrop-blur-md p-6 sm:p-8 transition-all duration-300 hover:shadow-xl hover:shadow-brand-primary/10 hover:border-brand-primary/40">
  <!-- Interactive backdrop glow -->
  <div class="absolute inset-0 bg-gradient-to-tr from-brand-primary/8 via-transparent to-brand-secondary/6 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

  <!-- Ambient background grid pattern -->
  <div class="absolute inset-0 opacity-[0.025] dark:opacity-[0.04] pointer-events-none bg-[radial-gradient(var(--color-border-subtle)_1px,transparent_1px)] bg-[size:16px_16px]"></div>

  <!-- Card Visual: Holographic Deep Space Globe & Orbiting Flight -->
  <div class="offline-globe-wrapper relative w-full aspect-[340/230] mb-6 flex items-center justify-center select-none overflow-hidden rounded-2xl border border-border-subtle/30 bg-bg-surface/30">
    
    <!-- Atmospheric pulsing wave rings -->
    <div class="wave-outer absolute w-[260px] h-[260px] rounded-full border border-brand-primary/10 pointer-events-none"></div>
    <div class="wave-inner absolute w-[180px] h-[180px] rounded-full border border-brand-secondary/15 pointer-events-none"></div>

    <!-- Status Badge (Top-Right) -->
    <div class="absolute top-3 right-3 z-20 flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-border-subtle bg-bg-surface/85 backdrop-blur-md shadow-xs select-none">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-secondary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-secondary"></span>
      </span>
      <span class="font-mono text-[9px] font-bold text-text-main tracking-wider uppercase">
        <span class="lang-es">Modo Offline</span>
        <span class="lang-en">Offline Engine</span>
      </span>
    </div>

    <!-- Telemetry Pill (Top-Left) -->
    <div class="absolute top-3 left-3 z-20 flex items-center gap-1.5 px-2 py-0.5 rounded-md border border-border-subtle/60 bg-bg-surface/60 backdrop-blur-md shadow-xs select-none">
      <span class="font-mono text-[8px] font-semibold text-text-muted">0ms Network Req</span>
    </div>

    <!-- 3D Base Shadow for the Globe -->
    <div class="absolute w-[110px] h-[12px] bg-brand-primary/15 dark:bg-black/50 rounded-full filter blur-md transform translate-y-[68px]"></div>

    <svg 
      class="absolute inset-0 w-full h-full pointer-events-none overflow-visible" 
      viewBox="0 0 340 230" 
      preserveAspectRatio="none"
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- 3D spherical gradient for the globe -->
        <radialGradient id="globeBodyGrad" cx="35%" cy="35%" r="65%">
          <stop offset="0%" stop-color="var(--brand-secondary)" stop-opacity="0.3" />
          <stop offset="50%" stop-color="var(--brand-primary)" stop-opacity="0.12" />
          <stop offset="100%" stop-color="var(--bg-base)" stop-opacity="0" />
        </radialGradient>

        <!-- Dynamic glass sheen overlay -->
        <linearGradient id="glassSheen" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.2" />
          <stop offset="40%" stop-color="#ffffff" stop-opacity="0.03" />
          <stop offset="50%" stop-color="#000000" stop-opacity="0.05" />
          <stop offset="100%" stop-color="#000000" stop-opacity="0.25" />
        </linearGradient>

        <!-- Radar Sweep Gradient -->
        <linearGradient id="radarSweep" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--brand-secondary)" stop-opacity="0.5" />
          <stop offset="100%" stop-color="transparent" stop-opacity="0" />
        </linearGradient>

        <!-- Drop shadow for the airplane -->
        <filter id="airplaneShadow" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="1" dy="3" stdDeviation="3" flood-color="var(--brand-primary)" flood-opacity="0.4" />
        </filter>
      </defs>

      <!-- GLOBE BASE -->
      <circle cx="170" cy="115" r="60" fill="url(#globeBodyGrad)" />
      
      <!-- Grid Meridians -->
      <ellipse cx="170" cy="115" rx="20" ry="60" stroke="var(--brand-primary)" stroke-opacity="0.22" stroke-width="0.9" />
      <ellipse cx="170" cy="115" rx="42" ry="60" stroke="var(--brand-primary)" stroke-opacity="0.16" stroke-width="0.9" />

      <!-- Grid Parallels -->
      <ellipse cx="170" cy="115" rx="60" ry="16" stroke="var(--brand-primary)" stroke-opacity="0.22" stroke-width="0.9" />
      <ellipse cx="170" cy="94" rx="52" ry="11" stroke="var(--brand-primary)" stroke-opacity="0.15" stroke-width="0.9" />
      <ellipse cx="170" cy="136" rx="52" ry="11" stroke="var(--brand-primary)" stroke-opacity="0.15" stroke-width="0.9" />

      <!-- Embedded Blueprints Beacon Nodes (Glow Dots on Globe) -->
      <g class="globe-beacons">
        <circle cx="150" cy="95" r="2.5" fill="var(--brand-secondary)" class="animate-pulse" />
        <circle cx="150" cy="95" r="5" stroke="var(--brand-secondary)" stroke-width="0.8" stroke-opacity="0.5" class="animate-ping" />

        <circle cx="188" cy="112" r="2.5" fill="var(--brand-primary)" class="animate-pulse" />
        <circle cx="188" cy="112" r="5" stroke="var(--brand-primary)" stroke-width="0.8" stroke-opacity="0.5" class="animate-ping" style="animation-delay: 0.8s;" />

        <circle cx="162" cy="138" r="2.5" fill="var(--brand-secondary)" class="animate-pulse" style="animation-delay: 1.4s;" />
        <circle cx="162" cy="138" r="5" stroke="var(--brand-secondary)" stroke-width="0.8" stroke-opacity="0.5" class="animate-ping" style="animation-delay: 1.4s;" />
      </g>

      <!-- Abstract Continents Vector Shapes -->
      <path d="M 145 92 Q 154 84, 166 88 Q 172 92, 162 100 Q 152 102, 145 92 Z" fill="var(--brand-primary)" fill-opacity="0.18" />
      <path d="M 182 102 Q 196 96, 208 104 Q 212 114, 200 120 Q 186 120, 182 110 Z" fill="var(--brand-primary)" fill-opacity="0.15" />
      <path d="M 138 112 Q 150 106, 160 112 Q 164 122, 154 128 Q 144 130, 138 120 Z" fill="var(--brand-primary)" fill-opacity="0.12" />
      <path d="M 174 132 Q 186 126, 194 134 Q 196 142, 188 146 Q 176 144, 174 138 Z" fill="var(--brand-primary)" fill-opacity="0.14" />

      <!-- Sphere Outer Glass Ring -->
      <circle cx="170" cy="115" r="60" stroke="var(--brand-primary)" stroke-opacity="0.35" stroke-width="1.8" />
      <!-- Glass Sheen Overlay -->
      <circle cx="170" cy="115" r="60" fill="url(#glassSheen)" />

      <!-- ORBIT PATH -->
      <ellipse 
        cx="170" 
        cy="115" 
        rx="98" 
        ry="76" 
        stroke="var(--brand-secondary)" 
        stroke-opacity="0.25" 
        stroke-width="1.4" 
        stroke-dasharray="6 4" 
        fill="none" 
        class="orbit-path" 
      />

      <!-- ORBITING AIRPLANE WITH CONTRAIL -->
      <g filter="url(#airplaneShadow)">
        <animateMotion
          dur="14s"
          repeatCount="indefinite"
          rotate="auto"
          calcMode="paced"
          path="M 268,115 A 98,76 0 1,0 72,115 A 98,76 0 1,0 268,115"
        />
        <g transform="rotate(90) scale(1.45)">
          <!-- Left Wing (Light highlight) -->
          <path
            d="M 0,-15 C 0.5,-12 1,-9 1,-4 L 14,2 L 14,3.5 L 1,1 L 1,9 L 5.5,12 L 5.5,13.5 L 0,12 Z"
            fill="var(--brand-secondary)"
          />
          <!-- Right Wing (Shaded depth) -->
          <path
            d="M 0,-15 C -0.5,-12 -1,-9 -1,-4 L -14,2 L -14,3.5 L -1,1 L -1,9 L -5.5,12 L -5.5,13.5 L 0,12 Z"
            fill="var(--brand-primary)"
            class="opacity-80"
          />
          <!-- Cockpit Window -->
          <path d="M 0,-12 C 0.4,-10 0.4,-8 0,-6 C -0.4,-8 -0.4,-10 0,-12 Z" fill="#ffffff" />
          
          <!-- Jet Engine Ion Glow -->
          <circle cx="0" cy="14" r="2.5" fill="var(--brand-secondary)" class="animate-pulse" />
        </g>
      </g>
    </svg>

    <!-- Bottom Embedded Status -->
    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1 px-2.5 py-0.5 rounded-full border border-border-subtle/50 bg-bg-surface/75 backdrop-blur-md shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <span class="font-mono text-[8px] font-semibold text-text-muted">//go:embed 100% Offline</span>
    </div>
  </div>

  <!-- Card Copy -->
  <div class="mt-auto relative z-15 select-none">
    <div class="flex items-center gap-2 mb-2">
      <div class="w-1 h-4 bg-brand-secondary rounded-full"></div>
      <h3 class="text-base font-bold text-text-main lang-es">Desconectividad Total</h3>
      <h3 class="text-base font-bold text-text-main lang-en">100% Offline Scaffolding</h3>
    </div>
    <p class="text-xs text-text-muted leading-relaxed lang-es">
      Crea proyectos completos sin Wi-Fi. Koko compila todas las plantillas directamente en el binario local, eliminando descargas lentas.
    </p>
    <p class="text-xs text-text-muted leading-relaxed lang-en">
      Generate complete projects with zero internet. Koko embeds all templates inside the local binary, avoiding slow registry downloads.
    </p>
  </div>
</div>

<style>
  @keyframes wave-breathe-inner {
    0%, 100% {
      transform: scale(0.95);
      opacity: 0.12;
    }
    50% {
      transform: scale(1.25);
      opacity: 0.35;
    }
  }

  @keyframes wave-breathe-outer {
    0%, 100% {
      transform: scale(0.9);
      opacity: 0.05;
    }
    50% {
      transform: scale(1.45);
      opacity: 0.22;
    }
  }

  .wave-inner {
    animation: wave-breathe-inner 6s ease-in-out infinite;
  }

  .wave-outer {
    animation: wave-breathe-outer 6s ease-in-out infinite;
    animation-delay: 3s;
  }

  .orbit-path {
    transition: stroke-opacity 0.3s, stroke 0.3s;
  }
  .group:hover .orbit-path {
    stroke-opacity: 0.5;
    stroke: var(--brand-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-inner,
    .wave-outer {
      animation: none !important;
    }
  }
</style>

