---
import { SvglGoLogo } from '@selemondev/svgl-svelte';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
---

<div class="md:col-span-3 group relative flex flex-col justify-between overflow-visible rounded-3xl border border-border-subtle bg-bg-surface/40 backdrop-blur-md p-6 sm:p-8 transition-all duration-300 hover:shadow-xl hover:shadow-brand-secondary/10 hover:border-brand-secondary/40">
  <div class="absolute inset-0 rounded-3xl bg-gradient-to-tr from-brand-secondary/6 via-brand-primary/4 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none overflow-hidden"></div>
  
  <!-- Subtle background grid -->
  <div class="absolute inset-0 opacity-[0.02] dark:opacity-[0.035] pointer-events-none bg-[radial-gradient(var(--color-border-subtle)_1px,transparent_1px)] bg-[size:16px_16px]"></div>

  <!-- Koko Rocket Mascot (Blazing Fast Performance) -->
  <div class="absolute -top-10 sm:-top-14 right-6 sm:right-10 z-20 pointer-events-none select-none">
    <img 
      src="/koko-cohete.png" 
      alt="Koko en cohete veloz" 
      class="w-20 h-20 sm:w-24 sm:h-24 object-contain filter drop-shadow-[0_8px_20px_rgba(90,79,196,0.3)] dark:drop-shadow-[0_8px_24px_rgba(155,141,247,0.45)] transition-transform duration-500 ease-out group-hover:translate-x-1.5 group-hover:-translate-y-2.5 group-hover:scale-110" 
    />
  </div>
  
  <!-- Visual Performance Mockup -->
  <div class="relative w-full mb-6 flex flex-col justify-end select-none overflow-visible pt-2">
    
    <!-- Top Header Label -->
    <div class="flex items-center justify-between mb-4 px-1">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-primary"></span>
        </span>
        <span class="text-[11px] font-mono font-bold tracking-wider text-text-muted uppercase">
          {lang === 'es' ? 'TIEMPO DE EJECUCIÓN' : 'EXECUTION TIME'}
        </span>
      </div>
      <span class="text-[10px] text-brand-primary font-mono font-bold px-2.5 py-0.5 rounded-full bg-bg-surface/80 border border-brand-primary/40 shadow-xs">
        {lang === 'es' ? '⚡ 100x más rápido' : '⚡ 100x faster'}
      </span>
    </div>

    <!-- Y-Axis + Chart Container -->
    <div class="flex items-stretch gap-3 w-full relative">

      <!-- Y-Axis Scale (Left) -->
      <div class="relative flex flex-col justify-between text-[10px] font-mono text-text-muted/70 h-[140px] pr-3 shrink-0 border-r border-border-subtle/70 select-none">
        <span>150ms</span>
        <span>100ms</span>
        <span>50ms</span>
        <span>0ms</span>
      </div>

      <!-- Main Chart & Badges Wrapper -->
      <div class="relative flex-1 flex flex-col">
        
        <!-- Chart Area -->
        <div class="relative h-[140px] grid grid-cols-3 items-end justify-items-center">
          
          <!-- Visible Dashed Grid Lines -->
          <div class="absolute inset-0 flex flex-col justify-between pointer-events-none">
            <div class="border-b border-dashed border-border-subtle/40 w-full"></div>
            <div class="border-b border-dashed border-border-subtle/40 w-full"></div>
            <div class="border-b border-dashed border-border-subtle/40 w-full"></div>
          </div>

          <!-- Column 1: Node.js -->
          <div class="flex flex-col items-center justify-end h-full w-full relative group/tower cursor-pointer z-10">
            <span class="text-[11px] font-mono font-semibold text-text-muted mb-1.5 transition-colors group-hover/tower:text-[#42b883]">
              120ms
            </span>

            <!-- Tooltip -->
            <div class="absolute bottom-[115px] left-1/2 -translate-x-1/2 w-44 p-3 bg-bg-surface/95 dark:bg-bg-surface border border-border-subtle rounded-2xl shadow-xl opacity-0 pointer-events-none group-hover/tower:opacity-100 transition-all duration-200 z-50 backdrop-blur-md">
              <p class="text-[11px] font-semibold text-text-main mb-1 flex items-center gap-1.5">
                <img src="/logos/nodejs.svg" alt="" class="w-3.5 h-3.5" /> Node.js CLI
              </p>
              <div class="flex flex-col gap-0.5 text-[10px] text-text-muted">
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Tiempo:' : 'Time:'}</span> 
                  <span class="font-mono text-text-main font-semibold">120ms</span>
                </div>
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Consumo:' : 'Memory:'}</span> 
                  <span class="font-mono">~35MB</span>
                </div>
              </div>
            </div>

            <div class="w-12 h-[105px] rounded-t-xl bg-[#42b883]/10 border-t border-x border-[#42b883]/30 hover:border-[#42b883]/60 hover:bg-[#42b883]/15 transition-all duration-300 shadow-sm flex items-center justify-center bar-node">
              <div class="w-full h-full rounded-t-xl stripe-node"></div>
            </div>
          </div>

          <!-- Column 2: Go Engine (Koko) -->
          <div class="flex flex-col items-center justify-end h-full w-full relative group/tower cursor-pointer z-10">
            <span class="text-[11px] font-mono font-extrabold text-[#00ADD8] mb-1.5 flex items-center gap-1">
              1.2ms
            </span>

            <!-- Tooltip -->
            <div class="absolute bottom-[40px] left-1/2 -translate-x-1/2 w-48 p-3 bg-bg-surface/95 dark:bg-bg-surface border border-[#00ADD8]/50 rounded-2xl shadow-xl opacity-0 pointer-events-none group-hover/tower:opacity-100 transition-all duration-200 z-50 backdrop-blur-md">
              <div class="flex items-center gap-1.5 mb-1">
                <img src="/logos/go.svg" alt="" class="w-4 h-4" />
                <p class="text-[11px] font-bold text-[#00ADD8]">Go Engine (Koko)</p>
              </div>
              <div class="flex flex-col gap-0.5 text-[10px] text-text-muted">
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Tiempo:' : 'Time:'}</span> 
                  <span class="font-mono text-[#00ADD8] font-bold">1.2ms (¡El mejor!)</span>
                </div>
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Consumo:' : 'Memory:'}</span> 
                  <span class="font-mono text-text-main font-semibold">~1.5MB</span>
                </div>
              </div>
            </div>

            <div class="w-12 h-[24px] rounded-t-xl bg-gradient-to-t from-[#0092b8] to-[#00ADD8] border-t border-x border-[#00ADD8] shadow-[0_0_24px_rgba(0,173,216,0.45)] hover:brightness-110 transition-all duration-300 relative overflow-hidden bar-go">
              <div class="absolute inset-0 bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.4),transparent)] animate-[pulse_2s_ease-in-out_infinite]"></div>
            </div>
          </div>

          <!-- Column 3: Rust -->
          <div class="flex flex-col items-center justify-end h-full w-full relative group/tower cursor-pointer z-10">
            <span class="text-[11px] font-mono font-semibold text-text-muted mb-1.5 transition-colors group-hover/tower:text-[#e05d44]">
              2.1ms
            </span>

            <!-- Tooltip -->
            <div class="absolute bottom-[50px] left-1/2 -translate-x-1/2 w-44 p-3 bg-bg-surface/95 dark:bg-bg-surface border border-border-subtle rounded-2xl shadow-xl opacity-0 pointer-events-none group-hover/tower:opacity-100 transition-all duration-200 z-50 backdrop-blur-md">
              <p class="text-[11px] font-semibold text-text-main mb-1 flex items-center gap-1.5">
                <img src="/logos/rust.svg" alt="" class="w-3.5 h-3.5" /> Rust CLI
              </p>
              <div class="flex flex-col gap-0.5 text-[10px] text-text-muted">
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Tiempo:' : 'Time:'}</span> 
                  <span class="font-mono text-text-main font-semibold">2.1ms</span>
                </div>
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Consumo:' : 'Memory:'}</span> 
                  <span class="font-mono">~2.4MB</span>
                </div>
              </div>
            </div>

            <div class="w-12 h-[34px] rounded-t-xl bg-[#e05d44]/10 border-t border-x border-[#e05d44]/30 hover:border-[#e05d44]/60 hover:bg-[#e05d44]/15 transition-all duration-300 shadow-sm flex items-center justify-center bar-rust">
              <div class="w-full h-full rounded-t-xl stripe-rust"></div>
            </div>
          </div>

        </div>

        <!-- Tech Badges Below Chart Grid -->
        <div class="grid grid-cols-3 justify-items-center pt-4">
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-bg-surface/90 border border-border-subtle shadow-xs">
            <img src="/logos/nodejs.svg" alt="Node.js" class="w-3.5 h-3.5 object-contain" />
            <span class="text-[11px] font-mono font-medium text-text-muted">Node</span>
          </div>

          <div class="flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#00ADD8] text-white font-mono font-bold border border-[#0092b8] shadow-md shadow-[#00ADD8]/25 scale-105">
            <img src="/logos/go.svg" alt="Go" class="w-3.5 h-3.5 object-contain brightness-0 invert" />
            <span class="text-[11px]">Go (Koko)</span>
          </div>

          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-bg-surface/90 border border-border-subtle shadow-xs">
            <img src="/logos/rust.svg" alt="Rust" class="w-3.5 h-3.5 object-contain" />
            <span class="text-[11px] font-mono font-semibold text-[#e05d44]">Rust</span>
          </div>
        </div>

      </div>
    </div>

  </div>
  
  <!-- Card Copy -->
  <div class="mt-auto relative z-15 select-none">
    <div class="flex items-center gap-2 mb-2">
      <div class="w-1 h-4 bg-brand-secondary rounded-full"></div>
      <h3 class="text-lg font-bold text-text-main lang-es">Rendimiento superior</h3>
      <h3 class="text-lg font-bold text-text-main lang-en">Superior Performance</h3>
    </div>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed lang-es align-middle">
      CLI construida en <span class="inline-block align-middle mx-1"><SvglGoLogo width={30} height={10} class="text-[#00ADD8] fill-current [&_g]:fill-current" /></span> con arranque instantáneo en 1.2ms, bajo consumo de memoria (~1.5MB) y ejecución 100x más veloz que alternativas tradicionales en Node.js.
    </p>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed lang-en">
      Engineered in native Go for blazing-fast execution speeds, near-instant sub-2ms scaffolding, and minimal memory footprint (~1.5MB RAM).
    </p>
  </div>
</div>

<style>
  .bar-node {
    animation: grow-bar-node 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: bottom;
  }
  .bar-go {
    animation: grow-bar-go 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.15s;
    transform-origin: bottom;
  }
  .bar-rust {
    animation: grow-bar-rust 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.3s;
    transform-origin: bottom;
  }

  @keyframes grow-bar-node {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @keyframes grow-bar-go {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @keyframes grow-bar-rust {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  .stripe-node {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 4px,
      rgba(66, 184, 131, 0.15) 4px,
      rgba(66, 184, 131, 0.15) 8px
    );
  }
  .stripe-rust {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 4px,
      rgba(224, 93, 68, 0.15) 4px,
      rgba(224, 93, 68, 0.15) 8px
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-node, .bar-go, .bar-rust {
      animation: none !important;
    }
  }
</style>

