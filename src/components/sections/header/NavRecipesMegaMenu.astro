---
import { recipesDropdownItems } from '@/data/navigation.data';

interface Props {
  currentLang?: string;
}

const { currentLang = 'es' } = Astro.props;
---

<div class="nav-dropdown pointer-events-none invisible opacity-0 absolute top-full left-1/2 pt-3 origin-top z-50">
  <div class="bg-bg-surface border border-border-subtle rounded-2xl p-6 shadow-xl w-[530px] antialiased">
    <div class="border-l-2 border-brand-primary pl-3 mb-4">
      <span class="block text-xs font-bold uppercase tracking-wider text-text-main">
        <span class="lang-es">Recetas Preconfiguradas</span>
        <span class="lang-en">Preconfigured Recipes</span>
      </span>
      <span class="block text-xs text-text-muted mt-0.5 leading-normal">
        <span class="lang-es">Elige una receta optimizada para iniciar tu proyecto en segundos</span>
        <span class="lang-en">Select an optimized template to bootstrap your project in seconds</span>
      </span>
    </div>
    
    <div class="grid grid-cols-2 gap-3 mt-4">
      {recipesDropdownItems.map((recipe) => (
        <a 
          href={currentLang === 'en' ? `/en/builder?preset=${recipe.id}` : `/builder?preset=${recipe.id}`} 
          class="group/card flex items-center gap-3 p-3 rounded-xl border border-border-subtle bg-bg-base hover:border-brand-primary/40 text-left cursor-pointer transition-colors duration-150"
        >
          <div class="w-9 h-9 rounded-lg bg-bg-surface border border-border-subtle flex items-center justify-center shrink-0">
            <img src={recipe.icon} class="w-5.5 h-5.5 object-contain" alt="" />
          </div>
          <div class="flex flex-col gap-0.5">
            <span class={`text-[13px] font-semibold text-text-main ${recipe.color} transition-colors duration-150`}>
              <span class="lang-es">{recipe.nameEs}</span>
              <span class="lang-en">{recipe.nameEn}</span>
            </span>
            <span class="text-[11px] text-text-muted leading-snug line-clamp-1 font-normal">
              <span class="lang-es">{recipe.descEs}</span>
              <span class="lang-en">{recipe.descEn}</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>
