---
import SocialNav from '@/components/header/socialNav.astro';
import NavDocsMegaMenu from './NavDocsMegaMenu.astro';
import NavRecipesMegaMenu from './NavRecipesMegaMenu.astro';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || (Astro.url.pathname.startsWith('/en') ? 'en' : 'es');
---

<nav class="flex items-center gap-5 sm:gap-6 px-4 py-1.5 rounded-full bg-badge-bg border border-border-subtle backdrop-blur-md shadow-xs select-none font-sans relative">
  <!-- Docs with Mega Dropdown -->
  <div class="relative group py-1">
    <a 
      href={currentLang === 'es' ? '/docs' : '/en/docs'}
      class="text-[13px] font-medium text-text-muted hover:text-text-main flex items-center gap-1.5 cursor-pointer relative py-0.5"
    >
      <span class="lang-es">Docs</span>
      <span class="lang-en">Docs</span>
      <svg class="w-3 h-3 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
    
    <NavDocsMegaMenu currentLang={currentLang} />
  </div>

  <!-- FAQ Link -->
  <div class="relative py-1 group">
    <a 
      href={currentLang === 'es' ? '/#faq' : '/en/#faq'}
      class="text-[13px] font-medium text-text-muted hover:text-text-main py-0.5 relative block"
    >
      <span class="lang-es">FAQ</span>
      <span class="lang-en">FAQ</span>
    </a>
  </div>

  <!-- Recetas with Mega Dropdown -->
  <div class="relative group py-1">
    <a 
      href={currentLang === 'es' ? '/#showcase' : '/en/#showcase'}
      class="text-[13px] font-medium text-text-muted hover:text-text-main flex items-center gap-1.5 cursor-pointer relative py-0.5"
    >
      <span class="lang-es">Recetas</span>
      <span class="lang-en">Showcase</span>
      <svg class="w-3 h-3 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
    
    <NavRecipesMegaMenu currentLang={currentLang} />
  </div>
</nav>

<style>
  :global(.nav-dropdown) {
    pointer-events: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    transform: translateY(4px) translateZ(0);
    transition: opacity 0.15s ease-out,
                transform 0.15s ease-out,
                visibility 0.15s ease-out;
    will-change: opacity, transform;
    contain: layout style;
  }

  :global(.group:hover > .nav-dropdown),
  :global(.group:focus-within > .nav-dropdown) {
    pointer-events: auto !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: translateY(0) translateZ(0);
  }
</style>
