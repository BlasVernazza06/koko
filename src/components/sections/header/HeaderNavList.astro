---
import SocialNav from '@/components/header/socialNav.astro';
import NavDocsMegaMenu from './NavDocsMegaMenu.astro';
import NavRecipesMegaMenu from './NavRecipesMegaMenu.astro';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || (Astro.url.pathname.startsWith('/en') ? 'en' : 'es');
---

<nav class="header-nav-container flex items-center gap-5 sm:gap-6 px-4 py-1.5 rounded-full bg-badge-bg border border-border-subtle backdrop-blur-md shadow-xs select-none font-sans relative transition-[border-radius,border-color,background-color] duration-200">
  <!-- Docs with Mega Dropdown -->
  <div class="relative group py-1 has-dropdown">
    <a 
      href={currentLang === 'es' ? '/docs' : '/en/docs'}
      class="text-[13px] font-medium text-text-muted hover:text-text-main flex items-center gap-1.5 cursor-pointer relative py-0.5"
    >
      <span class="lang-es">Docs</span>
      <span class="lang-en">Docs</span>
      <svg class="w-3 h-3 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
    
    <NavDocsMegaMenu currentLang={currentLang} />
  </div>

  <!-- FAQ Link -->
  <div class="relative py-1 group">
    <a 
      href={currentLang === 'es' ? '/#faq' : '/en/#faq'}
      class="text-[13px] font-medium text-text-muted hover:text-text-main py-0.5 relative block"
    >
      <span class="lang-es">FAQ</span>
      <span class="lang-en">FAQ</span>
    </a>
  </div>

  <!-- Recetas with Mega Dropdown -->
  <div class="relative group py-1 has-dropdown">
    <a 
      href={currentLang === 'es' ? '/#showcase' : '/en/#showcase'}
      class="text-[13px] font-medium text-text-muted hover:text-text-main flex items-center gap-1.5 cursor-pointer relative py-0.5"
    >
      <span class="lang-es">Recetas</span>
      <span class="lang-en">Showcase</span>
      <svg class="w-3 h-3 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
    
    <NavRecipesMegaMenu currentLang={currentLang} />
  </div>
</nav>

<style>
  /* Morphing transition and seamless union for nav-dropdown */
  :global(.nav-dropdown) {
    pointer-events: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    transform: translateY(6px) scale(0.99);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.2s ease-out;
    will-change: opacity, transform;
    contain: layout style;
    transform-origin: top center;
  }

  :global(.group:hover > .nav-dropdown),
  :global(.group:focus-within > .nav-dropdown) {
    pointer-events: auto !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }

  /* Seamless visual morph bridge: bridge element fusing nav item with modal */
  .has-dropdown::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: -4px;
    right: -4px;
    height: 12px;
    background: transparent;
    z-index: 55;
  }

  /* When hovering an item with dropdown, seamlessly mask the seam between nav bar and dropdown */
  .has-dropdown:hover::before,
  .has-dropdown:focus-within::before {
    content: '';
    position: absolute;
    bottom: -8px;
    left: -8px;
    right: -8px;
    height: 14px;
    background-color: var(--bg-surface);
    z-index: 52;
  }
</style>
