---
import VideoCommandsShowcase from './VideoCommandsShowcase.svelte';

interface Props {
  lang?: string;
  class?: string;
}

const { lang = 'es', class: className = '' } = Astro.props;
---

<div class={`max-w-7xl mx-auto px-6 pt-20 sm:pt-28 lg:pt-32 pb-20 sm:pb-28 flex flex-col items-center justify-center relative z-20 ${className}`}>
  <section id="terminal" class="w-full max-w-[1240px] scroll-reveal relative">
    <VideoCommandsShowcase client:visible lang={lang} />
  </section>
</div>

