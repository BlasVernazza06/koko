---
import { Terminal } from '@lucide/astro'
const { lang = 'es' } = Astro.props;
import CopyCommand from "@/components/landing/copyCommand.svelte";
import FeaturesSec from "@/components/landing/featuresSec.astro";
import TerminalSimulator from "@/components/TerminalSimulator.svelte";
import FaqSec from "@/components/landing/faqSec.astro";
import CtaSec from "@/components/landing/ctaSec.astro";
---

<main class="max-w-7xl mx-auto px-6 py-20 md:py-28 flex flex-col items-center justify-center relative z-10">
      
    <!-- Top announcement badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 mb-8 rounded-full bg-bg-surface border border-border-subtle text-xs text-text-muted select-none animate-fade-in-up">
      <span class="flex h-2 w-2 rounded-full bg-brand-primary animate-pulse"></span>
      <span class="lang-es">Claw CLI v0.1.0 ya está disponible</span>
      <span class="lang-en">Claw CLI v0.1.0 is now live</span>
    </div>

    <!-- Heading -->
    <div class="text-center max-w-4xl mx-auto mb-16 animate-fade-in-up animation-delay-100">
      <h1 class="text-4xl sm:text-5xl md:text-[64px] font-extrabold tracking-tight leading-[1.1] mb-6 font-sans">
        <span class="lang-es">Pasa de cero a producción <br class="hidden md:inline" /> en menos de 5 segundos.</span>
        <span class="lang-en">Go from zero to production <br class="hidden md:inline" /> in less than 5 seconds.</span>
      </h1>
      <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl mx-auto">
        <span class="lang-es">Claw-CLI es una herramienta moderna en Go diseñada para eliminar la fricción de configuración (Día 1) y evolucionar tu stack sin problemas (Día 2) con subcomandos activos.</span>
        <span class="lang-en">Claw-CLI is a modern, Go-powered developer ergonomics tool designed to eliminate setup friction (Day 1) and seamlessly evolve your stack (Day 2) with active subcommands.</span>
      </p>
    </div>

    <!-- Interactive installation & Wizard Builder launcher -->
    <div class="max-w-4xl mx-auto my-8 w-full font-sans grid grid-cols-1 md:grid-cols-12 gap-8 items-center justify-between animate-fade-in-up animation-delay-200">
      <div class="md:col-span-7 w-full">
        <CopyCommand client:load lang={lang} />
      </div>
      <div class="md:col-span-5 w-full flex flex-col items-center justify-center pl-0 md:pl-4">
        <a 
          href={lang === 'es' ? '/builder' : '/en/builder'} 
          class="flex items-center justify-center gap-2.5 bg-brand-primary hover:bg-brand-primary/95 active:scale-[0.98] transition-all w-full py-4 px-6 rounded-2xl shadow-xl shadow-brand-primary/15 hover:shadow-brand-primary/25 cursor-pointer font-bold text-white text-base text-center group border border-brand-primary/20"
        >
          <span>✨</span>
          <span class="lang-es">Construir Stack Visualmente</span>
          <span class="lang-en">Build Stack Visually</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Svelte Interactive Terminal Simulator -->
    <section id="terminal" class="w-full max-w-5xl animate-fade-in-up animation-delay-300">
      <TerminalSimulator client:load lang={lang} />
    </section>

    <!-- Divider line -->
    <div class="w-full max-w-5xl h-px bg-border-subtle my-20"></div>

    <!-- Features Section -->
    <FeaturesSec lang={lang} />

    <!-- FAQ Section -->
    <FaqSec lang={lang} />

    <!-- CTA Section -->
    <CtaSec />

</main>