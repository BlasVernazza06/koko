---
const { lang = 'es' } = Astro.props;
import CopyCommand from "@/components/landing/copyCommand.svelte";
import MiniBuilder from "@/components/landing/MiniBuilder.svelte";
import FeaturesSec from "@/components/landing/featuresSec.astro";
import TerminalSimulator from "@/components/TerminalSimulator.svelte";
import FaqSec from "@/components/landing/faqSec.astro";
import DocsSec from "@/components/landing/docsSec.astro";
import { SvglGoLogo } from '@selemondev/svgl-svelte';
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&display=swap');
  .font-serif-italic {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
  }
</style>

<main class="max-w-7xl mx-auto px-6 py-20 md:py-28 flex flex-col items-center justify-center relative z-10">
      
    <!-- Unified Top Pill Announcement Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-bg-surface/50 border border-border-subtle hover:border-brand-primary/40 backdrop-blur-md shadow-xs transition-all duration-300 mb-10 select-none animate-fade-in-up">
      <!-- Glow Dot -->
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-primary"></span>
      </span>
      
      <!-- Announcement text -->
      <span class="text-xs font-semibold text-text-main flex items-center gap-1.5">
        <span class="lang-es">Claw CLI v0.1.0 ya está disponible</span>
        <span class="lang-en">Claw CLI v0.1.0 is now live</span>
      </span>

      <!-- Divider line -->
      <span class="w-px h-3.5 bg-border-subtle/80"></span>

      <!-- Tech logo -->
      <div class="flex items-center gap-1.5">
        <span class="lang-es text-[11px] text-text-muted">Desarrollado con</span>
        <span class="lang-en text-[11px] text-text-muted">Powered by</span>
        <SvglGoLogo width={36} height={14} class="text-[#00ADD8] fill-current [&_g]:fill-current align-middle relative bottom-[1px]" />
      </div>
    </div>

    <!-- Heading -->
    <div class="text-center max-w-4xl mx-auto mb-16 animate-fade-in-up animation-delay-100">
      <h1 class="text-4xl sm:text-5xl md:text-[64px] font-extrabold tracking-tight leading-[1.15] mb-6 font-sans">
        <span class="lang-es">Pasa de cero a producción <br class="hidden md:inline" /> en menos de <span class="font-serif-italic text-brand-primary font-bold text-5xl sm:text-6xl md:text-[76px] relative top-[2px] lowercase">5 segundos.</span></span>
        <span class="lang-en">Go from zero to production <br class="hidden md:inline" /> in less than <span class="font-serif-italic text-brand-primary font-bold text-5xl sm:text-6xl md:text-[76px] relative top-[2px] lowercase">5 seconds.</span></span>
      </h1>
      <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl mx-auto font-sans">
        <span class="lang-es">Diseña, inicializa y escala tu arquitectura en segundos. La herramienta moderna en Go que elimina la fricción de configuración inicial (Día 1) y evoluciona tu stack de forma inteligente (Día 2).</span>
        <span class="lang-en">Design, scaffold, and scale your tech stack in seconds. A developer ergonomics tool built in Go to eliminate setup friction (Day 1) and intelligently evolve your architecture (Day 2).</span>
      </p>
    </div>

    <!-- Interactive installation & Wizard Builder launcher -->
    <div class="max-w-4xl mx-auto my-12 w-full font-sans grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch animate-fade-in-up animation-delay-200">
      <!-- Left Card: CLI Command -->
      <div class="w-full flex flex-col">
        <CopyCommand client:load lang={lang} />
      </div>
      
      <!-- Right Card: Wizard Builder launcher -->
      <div class="w-full flex">
        <MiniBuilder client:load lang={lang} />
      </div>
    </div>

    <!-- Svelte Interactive Terminal Simulator -->
    <section id="terminal" class="w-full max-w-[1300px] animate-fade-in-up animation-delay-300">
      <TerminalSimulator client:load lang={lang} />
    </section>

    <!-- Divider line -->
    <div class="w-full max-w-5xl h-px bg-border-subtle my-20"></div>

    <!-- Features Section -->
    <FeaturesSec lang={lang} />

    <!-- FAQ Section -->
    <FaqSec lang={lang} />

    <!-- Docs Section -->
    <DocsSec lang={lang} />

</main>