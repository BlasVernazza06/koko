---
import { SvglGitHubLogo, SvglNPMLogo } from '@selemondev/svgl-svelte';
---

<div class="flex items-center gap-3">
    <!-- NPM -->
    <a 
        href="https://github.com/BlasVernazza06/claw-cli" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-text-muted hover:text-text-main transition-colors"
        aria-label="NPM Registry"
    >
        <SvglNPMLogo class="w-[22px] h-[22px]" />
    </a>

    <!-- GitHub -->
    <a 
        href="https://github.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-text-muted hover:text-text-main transition-colors"
        aria-label="GitHub Repository"
    >
        <SvglGitHubLogo class="w-[22px] h-[22px] text-current" />
    </a>
</div>