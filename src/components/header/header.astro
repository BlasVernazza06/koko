---
import Logo from './logo.astro';
import NavList from './navList.astro';
import SocialNav from './socialNav.astro';
import ThemeToggle from './themeToggle.astro';
import LanguageToggle from './languageToggle.astro';
import SearchModal from './SearchModal.svelte';

const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
---

<header class="w-full sticky top-0 z-50 border-b border-border-subtle bg-bg-base/80 backdrop-blur-md transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    
    <!-- Left Section: Logo & Nav -->
    <div class="flex items-center gap-8">
      <Logo />
      <div class="hidden md:block">
        <NavList />
      </div>
    </div>

    <!-- Right Section: Search, Theme Toggle, Socials -->
    <div class="flex items-center gap-4">
      
      <!-- Searchbar Modal -->
      <SearchModal lang={currentLang} client:load />

      <div class="h-4 w-px bg-border-subtle"></div>

      <!-- Language Switcher -->
      <LanguageToggle />

      <div class="h-4 w-px bg-border-subtle"></div>
      
      <!-- Theme Switcher -->
      <ThemeToggle />

      <div class="h-4 w-px bg-border-subtle"></div>

      <!-- Social Networks & Tooling -->
      <SocialNav />
    </div>
  </div>
</header>