---
import Logo from '@/components/header/logo.astro';
import HeaderNavList from '@/components/sections/header/HeaderNavList.astro';
import SocialNav from '@/components/header/socialNav.astro';
import ThemeToggle from '@/components/header/themeToggle.astro';
import LanguageToggle from '@/components/header/languageToggle.astro';
import SearchModal from '@/components/header/SearchModal.svelte';

interface Props {
  revealOnScroll?: boolean;
}

const { revealOnScroll = false } = Astro.props;
const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
---

<header 
  id="main-header" 
  data-reveal-on-scroll={revealOnScroll ? "true" : "false"}
  class={revealOnScroll 
    ? "fixed top-0 inset-x-0 z-50 border-b border-transparent bg-transparent backdrop-blur-none -translate-y-full opacity-0 pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
    : "sticky top-0 z-50 w-full border-b border-transparent bg-transparent backdrop-blur-none transition-[background-color,border-color,backdrop-filter,box-shadow] duration-300 ease-out"
  }
>
  <div id="header-inner" class="max-w-7xl mx-auto px-6 h-16 md:h-18 flex items-center justify-between">
    
    <!-- Left Section: Logo & Nav -->
    <div class="flex items-center gap-8">
      <Logo />
      <div class="hidden md:block">
        <HeaderNavList />
      </div>
    </div>

    <!-- Right Section: Search, Theme Toggle, Socials -->
    <div class="flex items-center gap-4">
      
      <!-- Searchbar Modal -->
      <SearchModal lang={currentLang} client:idle />

      <div class="h-4 w-px bg-border-subtle/50 opacity-60"></div>

      <!-- Language Switcher -->
      <LanguageToggle />

      <div class="h-4 w-px bg-border-subtle/50 opacity-60"></div>
      
      <!-- Theme Switcher -->
      <ThemeToggle />

      <div class="h-4 w-px bg-border-subtle/50 opacity-60"></div>

      <!-- Social Networks & Tooling -->
      <SocialNav />
    </div>
  </div>
</header>

<script>
  function initHeaderScroll() {
    const header = document.getElementById('main-header');
    if (!header) return;

    const revealOnScroll = header.getAttribute('data-reveal-on-scroll') === 'true';

    const handleScroll = () => {
      const scrollY = window.scrollY;

      if (revealOnScroll) {
        const isRevealed = scrollY > 20;
        if (isRevealed) {
          header.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none', 'border-transparent', 'bg-transparent', 'backdrop-blur-none');
          header.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto', 'border-border-subtle/80', 'bg-bg-base/80', 'backdrop-blur-xl', 'shadow-[0_4px_30px_rgba(0,0,0,0.03)]');
        } else {
          header.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto', 'border-border-subtle/80', 'bg-bg-base/80', 'backdrop-blur-xl', 'shadow-[0_4px_30px_rgba(0,0,0,0.03)]');
          header.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none', 'border-transparent', 'bg-transparent', 'backdrop-blur-none');
        }
      } else {
        const isScrolled = scrollY > 12;
        if (isScrolled) {
          header.classList.remove('border-transparent', 'bg-transparent', 'backdrop-blur-none');
          header.classList.add('border-border-subtle/80', 'bg-bg-base/80', 'backdrop-blur-xl', 'shadow-[0_4px_30px_rgba(0,0,0,0.02)]');
        } else {
          header.classList.remove('border-border-subtle/80', 'bg-bg-base/80', 'backdrop-blur-xl', 'shadow-[0_4px_30px_rgba(0,0,0,0.02)]');
          header.classList.add('border-transparent', 'bg-transparent', 'backdrop-blur-none');
        }
      }
    };

    // Run on init to capture initial scroll position
    handleScroll();

    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Return cleanup function to deregister scroll listeners
    return () => {
      window.removeEventListener('scroll', handleScroll);
    };
  }

  let cleanupScroll: (() => void) | null | undefined = null;
  
  const setupScroll = () => {
    if (cleanupScroll) cleanupScroll();
    cleanupScroll = initHeaderScroll();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupScroll);
  } else {
    setupScroll();
  }

  document.addEventListener('astro:page-load', setupScroll);
  document.addEventListener('astro:after-swap', setupScroll);
</script>