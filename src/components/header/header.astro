---
import Logo from './logo.astro';
import NavList from './navList.astro';
import ThemeToggle from './themeToggle.svelte';
import { Search } from '@lucide/svelte';
import { SvglGitHubLogo, SvglNPMLogo } from '@selemondev/svgl-svelte';
---

<header class="w-full sticky top-0 z-50 border-b border-border-subtle bg-bg-base/80 backdrop-blur-md transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    
    <!-- Left Section: Logo & Nav -->
    <div class="flex items-center gap-8">
      <Logo />
      <div class="hidden md:block">
        <NavList />
      </div>
    </div>

    <!-- Right Section: Search, Theme Toggle, Socials -->
    <div class="flex items-center gap-4">
      
      <!-- Search pill (matches screenshot) -->
      <div class="hidden sm:flex items-center justify-between w-52 px-3 py-1.5 rounded-full bg-bg-surface border border-border-subtle hover:border-text-muted/30 transition-all cursor-pointer group">
        <div class="flex items-center gap-1.5 text-text-muted group-hover:text-text-main transition-colors">
          <Search size={13} strokeWidth={2.5} />
          <span class="text-[12px] font-medium">Search</span>
        </div>
        <kbd class="flex items-center text-[10px] font-mono text-text-muted border border-border-subtle bg-bg-base px-1.5 py-0.5 rounded-md shadow-sm">
          Ctrl K
        </kbd>
      </div>

      <!-- Theme Switcher -->
      <ThemeToggle client:load />

      <div class="h-4 w-px bg-border-subtle"></div>

      <!-- Social Networks & Tooling -->
      <div class="flex items-center gap-3">
        <!-- NPM -->
        <a 
          href="https://www.npmjs.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-text-muted hover:text-text-main transition-colors"
          aria-label="NPM Registry"
        >
          <SvglNPMLogo class="w-[18px] h-[18px]" />
        </a>

        <!-- X (Twitter) -->
        <a 
          href="https://x.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-text-muted hover:text-text-main transition-colors"
          aria-label="X (Twitter)"
        >
          <svg viewBox="0 0 24 24" class="w-[14px] h-[14px] fill-current">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>

        <!-- Discord -->
        <a 
          href="https://discord.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-text-muted hover:text-text-main transition-colors"
          aria-label="Discord Server"
        >
          <svg viewBox="0 0 127.14 96.36" class="w-[16px] h-[16px] fill-current">
            <path d="M107.7,8.07A105.15,105.15,0,0,0,77.26,0a77.19,77.19,0,0,0-3.3,6.83A96.67,96.67,0,0,0,53.22,6.83,77.19,77.19,0,0,0,49.88,0,105.15,105.15,0,0,0,19.44,8.07C3.66,31.58-1.86,54.65,1,77.53A105.73,105.73,0,0,0,32,96.36a77.7,77.7,0,0,0,6.63-10.85,68.43,68.43,0,0,1-10.5-5c.88-.65,1.72-1.34,2.51-2a75.58,75.58,0,0,0,73,0c.79.71,1.63,1.4,2.52,2a68.43,68.43,0,0,1-10.5,5,77.7,77.7,0,0,0,6.63,10.85,105.73,105.73,0,0,0,31.58-18.83C129,54.65,122.54,31.58,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53S36.18,40.36,42.45,40.36,53.83,46,53.83,53,48.72,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.24,60,73.24,53S78.41,40.36,84.69,40.36,96.07,46,96.07,53,91,65.69,84.69,65.69Z"/>
          </svg>
        </a>

        <!-- GitHub -->
        <a 
          href="https://github.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-text-muted hover:text-text-main transition-colors"
          aria-label="GitHub Repository"
        >
          <SvglGitHubLogo class="w-[17px] h-[17px] text-current" />
        </a>
      </div>

    </div>
  </div>
</header>