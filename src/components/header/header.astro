---
import Logo from './logo.astro';
import NavList from './navList.astro';
import SocialNav from './socialNav.astro';
import ThemeToggle from './themeToggle.svelte';
import { Search } from '@lucide/svelte';

---

<header class="w-full sticky top-0 z-50 border-b border-border-subtle bg-bg-base/80 backdrop-blur-md transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    
    <!-- Left Section: Logo & Nav -->
    <div class="flex items-center gap-8">
      <Logo />
      <div class="hidden md:block">
        <NavList />
      </div>
    </div>

    <!-- Right Section: Search, Theme Toggle, Socials -->
    <div class="flex items-center gap-4">
      
      <!-- Search pill (matches screenshot) -->
      <div class="hidden sm:flex items-center justify-between w-52 px-3 py-1.5 rounded-full bg-bg-surface border border-border-subtle hover:border-text-muted/30 transition-all cursor-pointer group">
        <div class="flex items-center gap-1.5 text-text-muted group-hover:text-text-main transition-colors">
          <Search size={13} strokeWidth={2.5} />
          <span class="text-[12px] font-medium">Search</span>
        </div>
        <kbd class="flex items-center text-[10px] font-mono text-text-muted border border-border-subtle bg-bg-base px-1.5 py-0.5 rounded-md shadow-sm">
          Ctrl K
        </kbd>
      </div>

      <!-- Theme Switcher -->
      <ThemeToggle client:load />

      <div class="h-4 w-px bg-border-subtle"></div>

      <!-- Social Networks & Tooling -->
      <SocialNav />
    </div>
  </div>
</header>