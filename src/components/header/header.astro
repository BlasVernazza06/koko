---
import Logo from '@/components/header/logo.astro';
import HeaderNavList from '@/components/sections/header/HeaderNavList.astro';
import SocialNav from '@/components/header/socialNav.astro';
import ThemeToggle from '@/components/header/themeToggle.astro';
import LanguageToggle from '@/components/header/languageToggle.astro';
import SearchModal from '@/components/header/SearchModal.svelte';
import { MoveUpRight } from '@lucide/svelte';

interface Props {
  revealOnScroll?: boolean;
}

const { revealOnScroll = false } = Astro.props;
const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
---

<header 
  id="main-header" 
  data-reveal-on-scroll={revealOnScroll ? "true" : "false"}
  class={revealOnScroll 
    ? "fixed top-0 inset-x-0 z-50 bg-transparent -translate-y-full opacity-0 pointer-events-none transition-[transform,opacity] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
    : "sticky top-0 z-50 w-full bg-transparent animate-header-enter"
  }
>
  <!-- SpaceFS Feathered Backdrop Blur -->
  <div 
    id="site-nav-backdrop" 
    aria-hidden="true" 
    class="site-nav-backdrop pointer-events-none absolute inset-x-0 top-0 z-0 opacity-0 transition-opacity duration-300"
  ></div>

  <div id="header-inner" class="w-full px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12 h-16 md:h-20 flex items-center justify-between relative z-10">
    
    <!-- Zone 1: Far Left (Logo & Brand) -->
    <div class="flex items-center shrink-0 z-10">
      <Logo />
    </div>

    <!-- Zone 2: Absolute Center (Nav Items exactly in the middle of the page) -->
    <div class="hidden lg:flex items-center justify-center absolute left-1/2 -translate-x-1/2 z-10 pointer-events-auto">
      <HeaderNavList />
    </div>

    <!-- Zone 3: Far Right (Search docs + Wizard CTA + Theme Toggle + Language) -->
    <div class="flex items-center gap-2 sm:gap-2.5 md:gap-3 shrink-0 z-10">
      <!-- 1. Search Trigger Modal ('Search docs Ctrl K') -->
      <SearchModal lang={currentLang} client:idle />

      <!-- 2. Wizard CTA (High-contrast pill with ↗) -->
      <a
        href={currentLang === 'es' ? '/builder' : '/en/builder'}
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs sm:text-sm font-semibold bg-text-main text-bg-base hover:opacity-90 shadow-sm transition-transform duration-150 cursor-pointer active:scale-95 group/wz shrink-0 border border-text-main/10"
        title="Visual Builder"
      >
        <span>Visual Builder</span>
        <MoveUpRight class="size-3.5 sm:size-4"/>
      </a>

      <!-- 3. SpaceFS Circular Theme Toggle -->
      <ThemeToggle />

      <!-- 4. Language Toggle -->
      <LanguageToggle />
    </div>
  </div>
</header>

<style>
  .site-nav-backdrop {
    height: 6.5rem;
    backdrop-filter: blur(20px) saturate(1.15);
    -webkit-backdrop-filter: blur(20px) saturate(1.15);
    background: hsla(0, 0%, 100%, 0.001);
    background: linear-gradient(
      180deg,
      var(--bg-base) 0%,
      color-mix(in srgb, var(--bg-base) 80%, transparent) 38%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.92) 38%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.92) 38%, transparent 100%);
  }

  @media (min-width: 768px) {
    .site-nav-backdrop {
      height: 7.5rem;
    }
  }
</style>

<script>
  function initHeaderScroll() {
    const header = document.getElementById('main-header');
    const backdrop = document.getElementById('site-nav-backdrop');
    if (!header) return;

    const revealOnScroll = header.getAttribute('data-reveal-on-scroll') === 'true';

    let lastState: boolean | null = null;

    const handleScroll = () => {
      const scrollY = window.scrollY;

      if (revealOnScroll) {
        const isRevealed = scrollY > 20;
        if (isRevealed === lastState) return;
        lastState = isRevealed;

        if (isRevealed) {
          header.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
          header.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
          if (backdrop) {
            backdrop.classList.remove('opacity-0');
            backdrop.classList.add('opacity-100');
          }
        } else {
          header.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          header.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
          if (backdrop) {
            backdrop.classList.remove('opacity-100');
            backdrop.classList.add('opacity-0');
          }
        }
      } else {
        const isScrolled = scrollY > 10;
        if (isScrolled === lastState) return;
        lastState = isScrolled;

        if (isScrolled) {
          if (backdrop) {
            backdrop.classList.remove('opacity-0');
            backdrop.classList.add('opacity-100');
          }
        } else {
          if (backdrop) {
            backdrop.classList.remove('opacity-100');
            backdrop.classList.add('opacity-0');
          }
        }
      }
    };

    // Run on init to capture initial scroll position
    handleScroll();

    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Return cleanup function to deregister scroll listeners
    return () => {
      window.removeEventListener('scroll', handleScroll);
    };
  }

  let cleanupScroll: (() => void) | null | undefined = null;
  
  const setupScroll = () => {
    if (cleanupScroll) cleanupScroll();
    cleanupScroll = initHeaderScroll();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupScroll);
  } else {
    setupScroll();
  }

  document.addEventListener('astro:page-load', setupScroll);
  document.addEventListener('astro:after-swap', setupScroll);
</script>