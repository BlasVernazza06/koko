---
const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';

const docsDropdownItems = [
  {
    titleEs: 'Inicio Rápido',
    titleEn: 'Quick Start',
    descEs: 'Empieza en minutos con Claw',
    descEn: 'Get started in minutes with Claw',
    href: '/docs/quick-start',
    hrefEn: '/en/docs/quick-start'
  },
  {
    titleEs: 'Comandos CLI',
    titleEn: 'CLI Commands',
    descEs: 'Referencia completa del CLI',
    descEn: 'Complete CLI reference guide',
    href: '/docs/cli-commands',
    hrefEn: '/en/docs/cli-commands'
  },
  {
    titleEs: 'Limitaciones',
    titleEn: 'Limitations',
    descEs: 'Restricciones y límites conocidos',
    descEn: 'Known limitations & boundaries',
    href: '/docs/cli-limitations',
    hrefEn: '/en/docs/cli-limitations'
  },
  {
    titleEs: 'Roadmap',
    titleEn: 'Roadmap',
    descEs: 'Planificación y desarrollo futuro',
    descEn: 'Future development & plans',
    href: '/docs/cli-roadmap',
    hrefEn: '/en/docs/cli-roadmap'
  },
  {
    titleEs: 'Estructura',
    titleEn: 'Structure',
    descEs: 'Organización de archivos generada',
    descEn: 'Generated file structure layout',
    href: '/docs/project-structure',
    hrefEn: '/en/docs/project-structure'
  },
  {
    titleEs: 'Koko Config',
    titleEn: 'Koko Config',
    descEs: 'Manifiesto y koko.config.json',
    descEn: 'Manifest & koko.config.json',
    href: '/docs/claw-config',
    hrefEn: '/en/docs/claw-config'
  },
  {
    titleEs: 'Contribución',
    titleEn: 'Contributing',
    descEs: 'Cómo colaborar en Claw',
    descEn: 'How to collaborate on Claw',
    href: '/docs/contributing',
    hrefEn: '/en/docs/contributing'
  },
  {
    titleEs: 'FAQ',
    titleEn: 'FAQ',
    descEs: 'Preguntas y respuestas comunes',
    descEn: 'Frequently asked questions',
    href: '/docs/faq',
    hrefEn: '/en/docs/faq'
  },
  {
    titleEs: 'Ver Todo',
    titleEn: 'View All',
    descEs: 'Explora toda la documentación',
    descEn: 'Explore all documentation',
    href: '/docs',
    hrefEn: '/en/docs'
  }
];

const recipesDropdownItems = [
  {
    id: 'saas-next',
    nameEs: 'SaaS Next.js',
    nameEn: 'SaaS Next.js',
    descEs: 'Next.js + Go + Prisma',
    descEn: 'Next.js + Go + Prisma',
    icon: '/logos/nextjs.svg',
    shadow: 'hover:shadow-[0_0_20px_rgba(255,255,255,0.06)] hover:border-text-main/20 dark:hover:shadow-[0_0_20px_rgba(255,255,255,0.04)]',
    color: 'group-hover/card:text-brand-secondary'
  },
  {
    id: 'fullstack-svelte',
    nameEs: 'Svelte 5 + NestJS',
    nameEn: 'Svelte 5 + NestJS',
    descEs: 'SvelteKit + NestJS + Drizzle',
    descEn: 'SvelteKit + NestJS + Drizzle',
    icon: '/logos/svelte.svg',
    shadow: 'hover:shadow-[0_0_20px_rgba(255,62,0,0.1)] hover:border-[rgba(255,62,0,0.35)]',
    color: 'group-hover/card:text-[orange]'
  },
  {
    id: 'mern',
    nameEs: 'Classic MERN',
    nameEn: 'Classic MERN',
    descEs: 'React + Express + MongoDB',
    descEn: 'React + Express + MongoDB',
    icon: '/logos/mongodb.svg',
    shadow: 'hover:shadow-[0_0_20px_rgba(79,191,81,0.1)] hover:border-[rgba(79,191,81,0.35)]',
    color: 'group-hover/card:text-[#4fbf51]'
  },
  {
    id: 'pern',
    nameEs: 'Modern PERN',
    nameEn: 'Modern PERN',
    descEs: 'React + Express + Postgres',
    descEn: 'React + Express + Postgres',
    icon: '/logos/postgresql.svg',
    shadow: 'hover:shadow-[0_0_20px_rgba(51,103,145,0.1)] hover:border-[rgba(51,103,145,0.35)]',
    color: 'group-hover/card:text-[#4169e1]'
  },
  {
    id: 'python-fastapi',
    nameEs: 'FastAPI + React',
    nameEn: 'FastAPI + React',
    descEs: 'React + FastAPI + Supabase',
    descEn: 'React + FastAPI + Supabase',
    icon: '/logos/python.svg',
    shadow: 'hover:shadow-[0_0_20px_rgba(0,150,136,0.1)] hover:border-[rgba(0,150,136,0.35)]',
    color: 'group-hover/card:text-[#009688]'
  },
  {
    id: 'mobile-go',
    nameEs: 'Native + Go',
    nameEn: 'Native + Go',
    descEs: 'Expo + Go Fiber + Supabase',
    descEn: 'Expo + Go Fiber + Supabase',
    icon: '/logos/react.svg',
    shadow: 'hover:shadow-[0_0_20px_rgba(0,208,255,0.1)] hover:border-[rgba(0,208,255,0.35)]',
    color: 'group-hover/card:text-[#00d0ff]'
  }
];
---

<nav class="flex items-center gap-7 select-none font-sans relative">
  <!-- Docs with Dropdown -->
  <div class="relative group py-3">
    <a 
      href={currentLang === 'es' ? '/docs' : '/en/docs'}
      class="text-[13.5px] font-bold text-text-muted hover:text-text-main transition-colors duration-300 flex items-center gap-1.5 cursor-pointer relative py-1"
    >
      <span class="lang-es">Docs</span>
      <span class="lang-en">Docs</span>
      <svg class="w-3 h-3 opacity-60 group-hover:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
      <!-- Premium active glow line -->
      <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-350 ease-out origin-center rounded-full opacity-80 shadow-[0_0_8px_var(--brand-primary)]"></span>
    </a>
    
    <!-- Mega-dropdown absolute element -->
    <div class="nav-dropdown pointer-events-none invisible opacity-0 absolute top-full left-0 pt-2 origin-top-left z-50">
      <div class="bg-bg-surface border border-border-subtle rounded-2xl p-6 shadow-[0_12px_40px_rgba(0,0,0,0.12)] dark:shadow-[0_12px_50px_rgba(0,0,0,0.35)] w-[690px] flex gap-6">
        <!-- Left Column: Links (60%) -->
        <div class="w-[58%] flex flex-col justify-between">
          <div>
            <div class="border-l-2 border-brand-secondary pl-3 mb-4">
              <span class="block text-xs font-bold uppercase tracking-wider text-text-main">
                <span class="lang-es">Documentación de Claw</span>
                <span class="lang-en">Claw Documentation</span>
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-x-3 gap-y-2">
              {docsDropdownItems.slice(0, 8).map((doc) => (
                <a 
                  href={currentLang === 'en' ? doc.hrefEn : doc.href} 
                  class="group/doc flex items-start gap-2.5 p-2 rounded-xl border border-transparent hover:border-border-subtle/50 hover:bg-bg-base/40 transition-all duration-200"
                >
                  <!-- Glow bullet on hover -->
                  <div class="w-1.5 h-1.5 rounded-full bg-text-muted/30 group-hover/doc:bg-brand-primary group-hover/doc:scale-125 transition-all mt-1.5 shrink-0"></div>
                  <div class="flex flex-col gap-0.5">
                    <span class="text-xs font-bold text-text-main group-hover/doc:text-brand-primary transition-colors duration-200">
                      <span class="lang-es">{doc.titleEs}</span>
                      <span class="lang-en">{doc.titleEn}</span>
                    </span>
                    <span class="text-[10px] text-text-muted leading-tight line-clamp-1">
                      <span class="lang-es">{doc.descEs}</span>
                      <span class="lang-en">{doc.descEn}</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Bottom View All Button -->
          <a 
            href={currentLang === 'en' ? docsDropdownItems[8].hrefEn : docsDropdownItems[8].href}
            class="mt-4 flex items-center justify-between py-2 px-3.5 rounded-xl bg-bg-surface/85 hover:bg-bg-base border border-border-subtle text-xs font-extrabold text-brand-primary hover:text-brand-secondary/80 transition-all duration-200 shadow-sm"
          >
            <span class="flex items-center gap-1.5">
              <span class="lang-es">Ver toda la documentación</span>
              <span class="lang-en">View all documentation</span>
            </span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Vertical Divider -->
        <div class="w-px bg-border-subtle/60 self-stretch"></div>

        <!-- Right Column: Interactive FAQ Carousel (42%) -->
        <div class="w-[42%] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1.5 text-xs font-bold text-text-main mb-4 uppercase tracking-wider pl-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-brand-primary animate-pulse shrink-0"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
              <span class="lang-es">Preguntas Frecuentes</span>
              <span class="lang-en">FAQ Carousel</span>
            </div>

            <!-- Carousel Box -->
            <div class="relative bg-gradient-to-br from-brand-primary/5 to-brand-secondary/5 border border-brand-primary/10 rounded-xl p-4 min-h-[142px] overflow-hidden flex flex-col justify-between select-none shadow-inner">
              <div class="faq-slides-wrapper relative w-full h-[84px]">
                <!-- Slide 1 -->
                <div class="faq-slide transition-all duration-350 absolute inset-0 flex flex-col gap-1.5" data-index="0">
                  <h5 class="text-xs font-extrabold text-brand-primary leading-tight flex items-center gap-1">
                    <span class="lang-es">¿Qué es Koko?</span>
                    <span class="lang-en">What is Koko?</span>
                  </h5>
                  <p class="text-[10px] text-text-muted leading-relaxed">
                    <span class="lang-es">Koko es un CLI en Go nativo que inicializa repositorios listos para producción en segundos.</span>
                    <span class="lang-en">Koko is a native Go CLI that bootstraps production-ready repos in seconds.</span>
                  </p>
                </div>
                <!-- Slide 2 -->
                <div class="faq-slide transition-all duration-350 absolute inset-0 flex flex-col gap-1.5 opacity-0 pointer-events-none translate-x-4" data-index="1">
                  <h5 class="text-xs font-extrabold text-brand-primary leading-tight">
                    <span class="lang-es">¿Es gratis y de código libre?</span>
                    <span class="lang-en">Is it free & open?</span>
                  </h5>
                  <p class="text-[10px] text-text-muted leading-relaxed">
                    <span class="lang-es">Sí, es de código abierto en GitHub. Puedes utilizar ambas herramientas sin costo alguno en tus proyectos comerciales.</span>
                    <span class="lang-en">Yes, it is open source on GitHub. You can use both tools for free in your commercial projects.</span>
                  </p>
                </div>
                <!-- Slide 3 -->
                <div class="faq-slide transition-all duration-350 absolute inset-0 flex flex-col gap-1.5 opacity-0 pointer-events-none translate-x-4" data-index="2">
                  <h5 class="text-xs font-extrabold text-brand-primary leading-tight">
                    <span class="lang-es">¿Soporta monorepos?</span>
                    <span class="lang-en">Does it support monorepos?</span>
                  </h5>
                  <p class="text-[10px] text-text-muted leading-relaxed">
                    <span class="lang-es">Sí, viene pre-configurado para monorepos con Turborepo, linters globales (Biome) y múltiples workspaces.</span>
                    <span class="lang-en">Yes, it comes pre-configured for monorepos with Turborepo, global linters (Biome), and workspaces.</span>
                  </p>
                </div>
                <!-- Slide 4 -->
                <div class="faq-slide transition-all duration-350 absolute inset-0 flex flex-col gap-1.5 opacity-0 pointer-events-none translate-x-4" data-index="3">
                  <h5 class="text-xs font-extrabold text-brand-primary leading-tight">
                    <span class="lang-es">¿Cómo añado Docker?</span>
                    <span class="lang-en">How to add Docker?</span>
                  </h5>
                  <p class="text-[10px] text-text-muted leading-relaxed">
                    <span class="lang-es">Puedes seleccionar la opción en el generador de recetas de Koko y generará la base de Docker Compose automáticamente.</span>
                    <span class="lang-en">You can select Docker in Koko's recipe builder and it compiles the Docker Compose files automatically.</span>
                  </p>
                </div>
              </div>

              <!-- Carousel Controls -->
              <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-brand-primary/10">
                <!-- Dots indicators -->
                <div class="flex gap-1.5 items-center">
                  <button class="faq-dot w-2 h-2 rounded-full bg-brand-primary transition-all duration-300 cursor-pointer" data-index="0" aria-label="Go to slide 1"></button>
                  <button class="faq-dot w-1.5 h-1.5 rounded-full bg-text-muted/30 transition-all duration-300 cursor-pointer" data-index="1" aria-label="Go to slide 2"></button>
                  <button class="faq-dot w-1.5 h-1.5 rounded-full bg-text-muted/30 transition-all duration-300 cursor-pointer" data-index="2" aria-label="Go to slide 3"></button>
                  <button class="faq-dot w-1.5 h-1.5 rounded-full bg-text-muted/30 transition-all duration-300 cursor-pointer" data-index="3" aria-label="Go to slide 4"></button>
                </div>
                <!-- Navigation arrow buttons -->
                <div class="flex gap-1">
                  <button class="faq-prev w-5 h-5 rounded-md border border-border-subtle bg-bg-surface/80 flex items-center justify-center text-text-muted hover:text-text-main hover:bg-bg-surface transition-all cursor-pointer" aria-label="Previous question">
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                  </button>
                  <button class="faq-next w-5 h-5 rounded-md border border-border-subtle bg-bg-surface/80 flex items-center justify-center text-text-muted hover:text-text-main hover:bg-bg-surface transition-all cursor-pointer" aria-label="Next question">
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
          
          <span class="block text-[10px] text-text-muted leading-tight mt-2 text-center">
            <span class="lang-es">¿Tienes más dudas? Ve al <a href="#faq" class="text-brand-primary underline font-semibold">FAQ del sitio</a>.</span>
            <span class="lang-en">Any other questions? See the <a href="#faq" class="text-brand-primary underline font-semibold">site FAQ</a>.</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Builder (Simple link) -->
  <div class="relative py-3 group">
    <a 
      href={currentLang === 'es' ? '/builder' : '/en/builder'}
      class="text-[13.5px] font-bold text-text-muted hover:text-text-main transition-colors duration-300 py-1 relative block"
    >
      <span class="lang-es">Builder</span>
      <span class="lang-en">Builder</span>
      <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-350 ease-out origin-center rounded-full opacity-80 shadow-[0_0_8px_var(--brand-primary)]"></span>
    </a>
  </div>

  <!-- Recetas with Dropdown -->
  <div class="relative group py-3">
    <a 
      href={currentLang === 'es' ? '/#showcase' : '/en/#showcase'}
      class="text-[13.5px] font-bold text-brand-primary hover:text-brand-primary/80 transition-colors duration-300 flex items-center gap-1.5 cursor-pointer relative py-1"
    >
      <span class="lang-es">Recetas</span>
      <span class="lang-en">Showcase</span>
      <svg class="w-3 h-3 opacity-60 group-hover:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
      <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-350 ease-out origin-center rounded-full opacity-80 shadow-[0_0_8px_var(--brand-secondary)]"></span>
    </a>
    
    <!-- Mega-dropdown absolute element -->
    <div class="nav-dropdown pointer-events-none invisible opacity-0 absolute top-full left-0 pt-2 origin-top-left z-50">
      <div class="bg-bg-surface/95 border border-border-subtle rounded-2xl p-6 shadow-[0_12px_40px_rgba(0,0,0,0.12)] dark:shadow-[0_12px_50px_rgba(0,0,0,0.35)] backdrop-blur-xl w-[530px]">
        <div class="border-l-2 border-brand-primary pl-3 mb-4">
          <span class="block text-xs font-bold uppercase tracking-wider text-text-main">
            <span class="lang-es">Recetas Preconfiguradas</span>
            <span class="lang-en">Preconfigured Recipes</span>
          </span>
          <span class="block text-[10.5px] text-text-muted mt-0.5 leading-normal">
            <span class="lang-es">Elige una receta optimizada para iniciar tu proyecto en segundos</span>
            <span class="lang-en">Select an optimized template to bootstrap your project in seconds</span>
          </span>
        </div>
        
        <div class="grid grid-cols-2 gap-3 mt-4">
          {recipesDropdownItems.map((recipe) => (
            <a 
              href={currentLang === 'en' ? `/en/builder?preset=${recipe.id}` : `/builder?preset=${recipe.id}`} 
              class={`group/card flex items-center gap-3 p-3 rounded-xl border border-border-subtle bg-bg-base/30 backdrop-blur-sm transition-all duration-300 text-left cursor-pointer ${recipe.shadow}`}
            >
              <div class="w-9 h-9 rounded-lg bg-bg-base border border-border-subtle/80 flex items-center justify-center shrink-0 transition-transform duration-300 group-hover/card:scale-110">
                <img src={recipe.icon} class="w-5.5 h-5.5 object-contain" alt="" />
              </div>
              <div class="flex flex-col gap-0.5">
                <span class={`text-xs font-bold text-text-main transition-colors duration-200 ${recipe.color}`}>
                  <span class="lang-es">{recipe.nameEs}</span>
                  <span class="lang-en">{recipe.nameEn}</span>
                </span>
                <span class="text-[10px] text-text-muted leading-tight line-clamp-1">
                  <span class="lang-es">{recipe.descEs}</span>
                  <span class="lang-en">{recipe.descEn}</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-dropdown {
    pointer-events: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    transform: translateY(6px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .group:hover > .nav-dropdown,
  .group:focus-within > .nav-dropdown {
    pointer-events: auto !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script>
  function initFaqCarousel() {
    const wrap = document.querySelector('.faq-slides-wrapper');
    if (!wrap) return;
    
    const slides = wrap.querySelectorAll('.faq-slide');
    const dots = document.querySelectorAll('.faq-dot');
    const prevBtn = document.querySelector('.faq-prev');
    const nextBtn = document.querySelector('.faq-next');
    if (slides.length === 0) return;

    let currentIndex = 0;
    let timer: any = null;

    function showSlide(index: number) {
      currentIndex = (index + slides.length) % slides.length;
      
      slides.forEach((slide, i) => {
        const el = slide as HTMLElement;
        if (i === currentIndex) {
          el.classList.remove('opacity-0', 'pointer-events-none', 'translate-x-4');
          el.classList.add('opacity-100', 'translate-x-0');
        } else {
          el.classList.remove('opacity-100', 'translate-x-0');
          el.classList.add('opacity-0', 'pointer-events-none', 'translate-x-4');
        }
      });

      dots.forEach((dot, i) => {
        const el = dot as HTMLElement;
        if (i === currentIndex) {
          el.classList.remove('bg-text-muted/30', 'w-1.5', 'h-1.5');
          el.classList.add('bg-brand-primary', 'w-3.5', 'h-2', 'rounded-full');
        } else {
          el.classList.remove('bg-brand-primary', 'w-3.5', 'h-2', 'rounded-full');
          el.classList.add('bg-text-muted/30', 'w-1.5', 'h-1.5');
        }
      });
    }

    function nextSlide() {
      showSlide(currentIndex + 1);
    }

    function prevSlide() {
      showSlide(currentIndex - 1);
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(nextSlide, 5000);
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    // Initialize state
    showSlide(0);
    startTimer();

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      prevSlide();
      startTimer();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      nextSlide();
      startTimer();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const idx = parseInt(dot.getAttribute('data-index') || '0');
        showSlide(idx);
        startTimer();
      });
    });

    // Pause on hover
    const carouselBox = wrap.closest('.relative');
    carouselBox?.addEventListener('mouseenter', stopTimer);
    carouselBox?.addEventListener('mouseleave', startTimer);
  }

  // Load handler
  initFaqCarousel();
  document.addEventListener('astro:after-swap', initFaqCarousel);
</script>
