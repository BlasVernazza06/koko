---
const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';

const NavItems = [
  { 
    labelEs: 'Docs', 
    labelEn: 'Docs', 
    href: currentLang === 'es' ? '/docs' : '/en/docs' 
  },
  { 
    labelEs: 'Builder', 
    labelEn: 'Builder', 
    href: currentLang === 'es' ? '/builder' : '/en/builder' 
  },
  { 
    labelEs: 'Recetas', 
    labelEn: 'Showcase', 
    href: currentLang === 'es' ? '/#showcase' : '/en/#showcase',
    isHighlighted: true 
  },
  { 
    labelEs: 'Demo', 
    labelEn: 'Demo', 
    href: currentLang === 'es' ? '/#terminal' : '/en/#terminal' 
  }
];
---

<nav class="flex items-center gap-6 select-none font-sans">
  {NavItems.map((item) => (
    <a 
      href={item.href}
      class={`text-[13px] font-medium transition-colors duration-200 hover:text-text-main
        ${item.isHighlighted 
          ? 'text-brand-secondary hover:text-brand-secondary/80' 
          : 'text-text-muted'
        }`}
    >
      <span class="lang-es">{item.labelEs}</span>
      <span class="lang-en">{item.labelEn}</span>
    </a>
  ))}
</nav>
