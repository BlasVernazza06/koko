---
import { Terminal } from "@lucide/svelte";
---

<a href="/" class="flex items-center gap-2.5 group select-none">
  <!-- Rounded container for the icon -->
  <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-bg-surface border border-border-subtle shadow-sm group-hover:border-brand-primary/40 group-hover:bg-brand-primary/5 transition-all duration-300">
    <Terminal size={15} class="text-brand-primary group-hover:scale-110 transition-transform duration-300" strokeWidth={2.5} />
  </div>
  
  <!-- Brand text -->
  <span class="text-[15px] font-bold tracking-tight text-text-main transition-colors duration-300">
    Claw
  </span>
</a>