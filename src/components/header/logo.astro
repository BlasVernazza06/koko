---
// Logo component using Koko the Koala icon
---

<a href="/" class="flex items-center gap-2.5 group select-none">
  <!-- Rounded container for the icon -->
  <div class="flex items-center justify-center w-15 h-15 rounded-lg  transition-all duration-300 overflow-hidden">
    <img 
      src="/icons-koala.webp" 
      alt="Koko Koala Logo" 
      class="w-10 h-10 object-contain transition-transform duration-300 group-hover:scale-110" 
    />
  </div>
  
  <!-- Brand text -->
  <span class="text-[15px] font-bold tracking-tight text-text-main transition-colors duration-300">
    Koko
  </span>
</a>