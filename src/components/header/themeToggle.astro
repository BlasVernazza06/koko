<button
  id="theme-toggle"
  class="flex items-center justify-center w-10 h-10 rounded-full border border-border-subtle bg-bg-surface hover:bg-bg-base text-text-muted hover:text-text-main cursor-pointer shadow-xs active:scale-95 transition-transform duration-150 group"
  aria-label="Toggle dark mode"
  title="Cambiar tema"
>
  <!-- Sun Icon (shown in dark mode or dynamic) -->
  <svg class="sun-icon w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2"/><path d="M12 20v2"/>
    <path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
    <path d="M2 12h2"/><path d="M20 12h2"/>
    <path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
  </svg>

  <!-- Moon Icon -->
  <svg class="moon-icon w-[18px] h-[18px] hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<style>
  :global(.dark) .sun-icon {
    display: block;
    color: var(--text-main);
  }
  :global(.dark) .moon-icon {
    display: none;
  }
  :global(html:not(.dark)) .sun-icon {
    display: none;
  }
  :global(html:not(.dark)) .moon-icon {
    display: block;
    color: var(--text-main);
  }
</style>

<script>
  function initTheme() {
    const themeToggle = document.getElementById('theme-toggle');
    if (!themeToggle) return;

    const toggleTheme = () => {
      const doc = document.documentElement;
      const isDark = doc.classList.toggle('dark');
      doc.setAttribute('data-theme', isDark ? 'dark' : 'light');

      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {}
    };

    themeToggle.addEventListener('click', toggleTheme);
    return () => themeToggle.removeEventListener('click', toggleTheme);
  }

  let cleanupTheme: (() => void) | null | undefined = null;
  const setupTheme = () => {
    if (cleanupTheme) cleanupTheme();
    cleanupTheme = initTheme();
  };

  setupTheme();
  document.addEventListener('astro:after-swap', setupTheme);
</script>

