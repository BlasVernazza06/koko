---
interface Props {
  withPing?: boolean;
  class?: string;
}

const { withPing = true, class: className = '' } = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 px-4 py-2.5 sm:py-3 rounded-full bg-badge-bg border border-badge-border hover:border-badge-border-hover backdrop-blur-md shadow-xs transition-[transform] duration-200 select-none ${className}`}>
  <slot />
</div>
