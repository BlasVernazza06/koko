---
interface Props {
  withPing?: boolean;
  class?: string;
}

const { withPing = true, class: className = '' } = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 px-4 py-3 rounded-full bg-bg-surface/50 border border-gray-200 hover:border-gray-300 backdrop-blur-md shadow-xs transition-all duration-300 select-none ${className}`}>
  <slot />
</div>
