---
interface Props {
  withPing?: boolean;
  class?: string;
}

const { withPing = true, class: className = '' } = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-bg-surface/50 border border-border-subtle hover:border-brand-primary/40 backdrop-blur-md shadow-xs transition-all duration-300 select-none ${className}`}>
  {withPing && (
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-primary opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-primary"></span>
    </span>
  )}
  <slot />
</div>
