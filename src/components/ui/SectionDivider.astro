---
interface Props {
  class?: string;
  withGlow?: boolean;
}

const { class: className = '', withGlow = true } = Astro.props;
---

<div class={`w-full max-w-5xl mx-auto px-6 relative flex items-center justify-center my-16 md:my-24 select-none scroll-reveal ${className}`}>
  <!-- Tapered background line -->
  <div class="w-full h-px bg-gradient-to-r from-transparent via-border-subtle to-transparent"></div>

  {withGlow && (
    <!-- Center glowing pill/diamond accent -->
    <div class="absolute flex items-center justify-center pointer-events-none">
      <div class="w-12 h-4 bg-brand-primary/15 blur-md rounded-full"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-brand-primary/60 border border-brand-primary/40 shadow-xs"></div>
    </div>
  )}
</div>
