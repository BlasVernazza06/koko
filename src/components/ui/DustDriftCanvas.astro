---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div 
  class={`fixed inset-0 pointer-events-none select-none z-0 overflow-hidden ${className}`} 
  aria-hidden="true"
>
  <canvas 
    id="dust-drift-canvas" 
    class="w-full h-full block"
  ></canvas>
</div>

<script>
  function initDustDrift() {
    const canvas = document.getElementById('dust-drift-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true })!;
    if (!ctx) return;

    let animId: number;
    let width = 0;
    let height = 0;
    let time = 0;
    let scrollY = window.scrollY || 0;
    let targetScrollY = scrollY;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.resetTransform?.();
      ctx.scale(dpr, dpr);
    }

    function onScroll() {
      targetScrollY = window.scrollY || 0;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', resize);
    resize();

    function getPalette() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        return {
          // SpaceFS palette in dark mode
          c1: { r: 90, g: 130, b: 240 },   // Blue/Indigo
          c2: { r: 140, g: 110, b: 245 },  // Soft Violet
          c3: { r: 235, g: 145, b: 75 },   // Soft Amber/Copper
          beamAlpha: 0.05,
          dustAlphaMult: 0.45
        };
      } else {
        return {
          // SpaceFS clean palette in light mode
          c1: { r: 60, g: 95, b: 185 },
          c2: { r: 110, g: 85, b: 195 },
          c3: { r: 200, g: 115, b: 65 },
          beamAlpha: 0.035,
          dustAlphaMult: 0.35
        };
      }
    }

    // A tiny count of subtle stardust motes (ambient micro-particles)
    const DUST_COUNT = 65;
    const dustParticles: {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      baseAlpha: number;
      colorT: number;
      depth: number;
      pulseOffset: number;
    }[] = [];

    for (let i = 0; i < DUST_COUNT; i++) {
      dustParticles.push({
        x: Math.random(),
        y: Math.random(),
        vx: (Math.random() - 0.5) * 0.0001,
        vy: (Math.random() - 0.5) * 0.0001,
        radius: Math.random() * 1.1 + 0.45, // very fine grain (0.45px to 1.55px)
        baseAlpha: Math.random() * 0.6 + 0.2,
        colorT: Math.random(), // 0 = blue, 0.5 = violet, 1 = amber
        depth: Math.random() * 0.35 + 0.08,
        pulseOffset: Math.random() * Math.PI * 2
      });
    }

    function draw() {
      // Smooth scroll parallax damping
      scrollY += (targetScrollY - scrollY) * 0.06;

      ctx.clearRect(0, 0, width, height);
      const pal = getPalette();

      // 1. Two extremely subtle sweeping diagonal aurora beams (barely-there atmospheric depth)
      const scrollShift = scrollY * 0.08;
      
      // Beam 1: Cool blue/violet wash across upper diagonal
      const grad1 = ctx.createLinearGradient(
        0, 
        (height * 0.2 - scrollShift * 0.5) % height, 
        width, 
        (height * 0.6 - scrollShift * 0.5) % height
      );
      grad1.addColorStop(0, `rgba(${pal.c1.r}, ${pal.c1.g}, ${pal.c1.b}, 0)`);
      grad1.addColorStop(0.4, `rgba(${pal.c1.r}, ${pal.c1.g}, ${pal.c1.b}, ${pal.beamAlpha})`);
      grad1.addColorStop(0.7, `rgba(${pal.c2.r}, ${pal.c2.g}, ${pal.c2.b}, ${pal.beamAlpha * 0.8})`);
      grad1.addColorStop(1, `rgba(${pal.c2.r}, ${pal.c2.g}, ${pal.c2.b}, 0)`);

      ctx.fillStyle = grad1;
      ctx.fillRect(0, 0, width, height);

      // Beam 2: Warm copper highlight gently floating on the right side
      const grad2 = ctx.createRadialGradient(
        width * 0.85, 
        ((height * 0.5 - scrollShift * 0.3) % (height * 1.2) + height * 1.2) % (height * 1.2) - height * 0.1, 
        0,
        width * 0.85, 
        ((height * 0.5 - scrollShift * 0.3) % (height * 1.2) + height * 1.2) % (height * 1.2) - height * 0.1, 
        width * 0.5
      );
      grad2.addColorStop(0, `rgba(${pal.c3.r}, ${pal.c3.g}, ${pal.c3.b}, ${pal.beamAlpha * 1.2})`);
      grad2.addColorStop(1, `rgba(${pal.c3.r}, ${pal.c3.g}, ${pal.c3.b}, 0)`);

      ctx.fillStyle = grad2;
      ctx.fillRect(0, 0, width, height);

      // 2. Minimalist stardust motes floating with scroll parallax
      for (let i = 0; i < dustParticles.length; i++) {
        const p = dustParticles[i];

        if (!prefersReducedMotion) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0) p.x += 1;
          if (p.x > 1) p.x -= 1;
          if (p.y < 0) p.y += 1;
          if (p.y > 1) p.y -= 1;
        }

        const px = p.x * width;
        // Natural parallax drift linked to scroll
        const py = ((p.y * height - scrollY * p.depth) % height + height) % height;

        // Color interpolation: blue -> violet -> copper
        let r: number, g: number, b: number;
        if (p.colorT < 0.5) {
          const f = p.colorT / 0.5;
          r = pal.c1.r + (pal.c2.r - pal.c1.r) * f;
          g = pal.c1.g + (pal.c2.g - pal.c1.g) * f;
          b = pal.c1.b + (pal.c2.b - pal.c1.b) * f;
        } else {
          const f = (p.colorT - 0.5) / 0.5;
          r = pal.c2.r + (pal.c3.r - pal.c2.r) * f;
          g = pal.c2.g + (pal.c3.g - pal.c2.g) * f;
          b = pal.c2.b + (pal.c3.b - pal.c2.b) * f;
        }

        // Very slow breathing alpha
        const breathing = Math.sin(time * 1.5 + p.pulseOffset) * 0.2 + 0.8;
        const alpha = p.baseAlpha * pal.dustAlphaMult * breathing;

        ctx.beginPath();
        ctx.arc(px, py, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)}, ${alpha.toFixed(3)})`;
        ctx.fill();
      }

      time += 0.006;
      animId = requestAnimationFrame(draw);
    }

    draw();

    return () => {
      cancelAnimationFrame(animId);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', resize);
    };
  }

  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = initDustDrift();
  });

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    cleanup = initDustDrift();
  }
</script>
