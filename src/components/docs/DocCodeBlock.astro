---
interface Props {
  code: string;
  lang: 'es' | 'en';
}

const { code, lang } = Astro.props;

// Infer file type or command
const isJson = code.trim().startsWith('{');
const title = isJson ? 'claw.config.json' : 'Terminal';
---

<div class="rounded-2xl border border-border-subtle bg-bg-surface/35 overflow-hidden shadow-xs group/code my-5">
  <!-- macOS Title Bar -->
  <div class="flex items-center justify-between px-4 py-3 bg-bg-base/70 border-b border-border-subtle/50 text-xs text-text-muted font-mono select-none">
    <!-- Window controls -->
    <div class="flex items-center gap-1.5 shrink-0">
      <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56] opacity-75"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e] opacity-75"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f] opacity-75"></span>
    </div>
    <!-- Window title -->
    <span class="text-[11px] font-semibold text-text-muted/80">{title}</span>
    <!-- Empty element for spacing symmetry -->
    <div class="w-12 shrink-0"></div>
  </div>
  
  <!-- Code Area -->
  <div class="p-4 font-mono text-[11px] sm:text-xs flex justify-between items-start gap-4 text-brand-primary whitespace-pre overflow-x-auto">
    <code class="text-text-main flex-1 leading-relaxed">{code}</code>
    <button 
      data-copy-text={code}
      data-lang-es={lang === 'es' ? 'es' : 'en'}
      class="code-copy-btn shrink-0 flex items-center gap-1.5 px-2.5 py-1.5 bg-bg-base border border-border-subtle rounded-lg hover:border-brand-primary/45 hover:bg-bg-surface text-[10px] text-text-muted hover:text-text-main font-bold select-none cursor-pointer transition-all duration-200"
    >
      <span class="btn-icon-wrapper text-text-muted/80 shrink-0">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
      </span>
      <span class="btn-text shrink-0">{lang === 'es' ? 'Copiar' : 'Copy'}</span>
    </button>
  </div>
</div>

<script>
  function setupCodeCopy() {
    document.querySelectorAll('.code-copy-btn').forEach((btn) => {
      if (btn.getAttribute('data-listener-setup') === 'true') return;
      btn.setAttribute('data-listener-setup', 'true');
      
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-copy-text');
        if (text) {
          navigator.clipboard.writeText(text);
          const textSpan = btn.querySelector('.btn-text');
          const iconWrapper = btn.querySelector('.btn-icon-wrapper');
          if (textSpan && iconWrapper) {
            const originalText = textSpan.textContent;
            const originalIcon = iconWrapper.innerHTML;
            
            textSpan.textContent = btn.getAttribute('data-lang-es') === 'es' ? 'Copiado!' : 'Copied!';
            iconWrapper.innerHTML = `<svg class="w-3 h-3 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
            btn.classList.add('border-brand-primary/40');
            
            setTimeout(() => {
              textSpan.textContent = originalText;
              iconWrapper.innerHTML = originalIcon;
              btn.classList.remove('border-brand-primary/40');
            }, 1500);
          }
        }
      });
    });
  }

  // Trigger setup
  document.addEventListener('DOMContentLoaded', setupCodeCopy);
  setupCodeCopy();
  document.addEventListener('astro:after-swap', setupCodeCopy);
</script>

