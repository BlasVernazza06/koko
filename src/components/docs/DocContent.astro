---
import type { DocSection } from '@/lib/docsData';
import { docsData } from '@/lib/docsData';
import DocCodeBlock from '@/components/docs/DocCodeBlock.astro';
import DocDirectoryTree from '@/components/docs/DocDirectoryTree.astro';
import DocPagination from '@/components/docs/DocPagination.astro';
import DocFaq from '@/components/docs/DocFaq.svelte';
import { Link } from '@lucide/svelte';

interface Props {
  activeSection: DocSection;
  lang: 'es' | 'en';
}

const { activeSection, lang } = Astro.props;

const sections = docsData[lang];
const currentIndex = sections.findIndex(s => s.id === activeSection.id);
const prevSection = currentIndex > 0 ? sections[currentIndex - 1] : null;
const nextSection = currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null;
const basePath = lang === 'es' ? '/docs' : '/en/docs';
---

<main class="flex-1 min-w-0 max-w-3xl pb-20">
  
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-text-muted mb-4 font-mono select-none">
    <span>Docs</span>
    <span>/</span>
    <span>{activeSection.category}</span>
    <span>/</span>
    <span class="text-brand-primary">{activeSection.title}</span>
  </nav>

  <!-- Title block -->
  <div class="flex items-start justify-between gap-4 mb-10 pb-6 border-b border-border-subtle/50">
    <div class="space-y-3">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-primary">{activeSection.category}</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-main font-sans">{activeSection.title}</h1>
    </div>
  </div>

  <!-- Content Render -->
  {activeSection.id === 'faq' ? (
    <DocFaq activeSection={activeSection} lang={lang} client:load />
  ) : (
    <div class="space-y-16">
      {activeSection.content.map((block) => (
        <section id={block.anchorId} class="scroll-mt-28 space-y-4">
          <h2 class="group flex items-center gap-2 text-2xl font-bold tracking-tight text-text-main border-b border-border-subtle/60 pb-2">
            <span>{block.title}</span>
            <a href={`#${block.anchorId}`} class="opacity-0 group-hover:opacity-100 transition-all duration-200 text-brand-primary/55 hover:text-brand-primary" aria-label="Link to this section">
              <Link size={16} />
            </a>
          </h2>
          
          <div class="space-y-3">
            {block.body.map((p) => {
              if (p.startsWith('• ')) {
                const content = p.slice(2);
                const colonIndex = content.indexOf(':');
                if (colonIndex !== -1) {
                  const boldPart = content.slice(0, colonIndex);
                  const restPart = content.slice(colonIndex + 1);
                  return (
                    <div class="flex gap-2.5 text-sm text-text-muted leading-relaxed pl-1 py-0.5">
                      <span class="text-brand-primary select-none font-bold shrink-0">✓</span>
                      <span><strong class="text-text-main">{boldPart}</strong>:{restPart}</span>
                    </div>
                  );
                }
                return (
                  <div class="flex gap-2.5 text-sm text-text-muted leading-relaxed pl-1 py-0.5">
                    <span class="text-brand-primary select-none font-bold shrink-0">✓</span>
                    <span>{content}</span>
                  </div>
                );
              }
              return <p class="text-sm text-text-muted leading-relaxed">{p}</p>;
            })}
          </div>

          {block.bullets && (
            <ul class="list-disc pl-5 text-sm text-text-muted space-y-2 leading-relaxed">
              {block.bullets.map((bullet) => {
                const parts = bullet.split(' - ');
                if (parts.length > 1) {
                  return (
                    <li>
                      <strong>{parts[0]}</strong> - {parts.slice(1).join(' - ')}
                    </li>
                  );
                }
                return <li>{bullet}</li>;
              })}
            </ul>
          )}

          {block.pre && (
            <DocCodeBlock code={block.pre} lang={lang} />
          )}

          {block.nestedBlocks && (
            <div class="space-y-8 pl-4 border-l border-border-subtle/60 ml-2 mt-4">
              {block.nestedBlocks.map((nested) => (
                <div id={nested.anchorId} class="scroll-mt-28 space-y-3">
                  <h3 class="group flex items-center gap-2 text-lg font-bold text-text-main">
                    <span>{nested.title}</span>
                    <a href={`#${nested.anchorId}`} class="opacity-0 group-hover:opacity-100 transition-all duration-200 text-brand-primary/55 hover:text-brand-primary" aria-label="Link to this subsection">
                      <Link size={14} />
                    </a>
                  </h3>
                  <div class="space-y-2">
                    {nested.body.map((np) => (
                      <p class="text-xs sm:text-sm text-text-muted leading-relaxed">{np}</p>
                    ))}
                  </div>
                  {nested.pre && (
                    <DocCodeBlock code={nested.pre} lang={lang} />
                  )}
                </div>
              ))}
            </div>
          )}

          {block.tree && (
            <DocDirectoryTree tree={block.tree} />
          )}
        </section>
      ))}
    </div>
  )}

  <!-- Pagination -->
  <DocPagination 
    prevSection={prevSection} 
    nextSection={nextSection} 
    lang={lang} 
    basePath={basePath} 
  />
</main>

<script>
  // Setup copy helpers for any standard copy button in doc content
  document.addEventListener('DOMContentLoaded', () => {
    const initCopyButtons = () => {
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const text = btn.getAttribute('data-copy-text');
          if (text) {
            navigator.clipboard.writeText(text);
            const originalText = btn.textContent;
            btn.textContent = btn.getAttribute('data-copied') || (btn.textContent === 'Copiar' ? 'Copiado!' : 'Copied!');
            setTimeout(() => {
              btn.textContent = originalText;
            }, 1500);
          }
        });
      });
    };

    initCopyButtons();
    document.addEventListener('astro:after-swap', initCopyButtons);
  });
</script>

