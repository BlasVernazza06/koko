---
interface TreeItem {
  type: string;
  name: string;
  depth: number;
  description?: string;
}

interface Props {
  tree: TreeItem[];
}

const { tree } = Astro.props;
---

<div class="rounded-2xl border border-border-subtle bg-bg-surface/30 p-5 shadow-xs font-mono text-xs sm:text-sm space-y-2 select-none overflow-x-auto relative">
  {tree.map((item) => (
    <div class="relative flex items-center gap-2.5 py-1 group/tree-item" style={`padding-left: ${item.depth * 1.5}rem`}>
      
      <!-- Nesting guide vertical lines -->
      {Array.from({ length: item.depth }).map((_, idx) => (
        <div 
          class="absolute top-0 bottom-0 border-l border-border-subtle/50 pointer-events-none" 
          style={`left: ${(idx * 1.5) + 0.5}rem;`}
        ></div>
      ))}

      <!-- Icon -->
      {item.type === 'folder' ? (
        <svg class="w-4 h-4 text-brand-primary shrink-0 relative z-10 transition-transform duration-150 group-hover/tree-item:scale-105" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
      ) : (
        <svg class="w-4 h-4 text-brand-secondary shrink-0 relative z-10 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
      )}

      <!-- Name -->
      <span class={`relative z-10 select-text ${item.type === 'folder' ? 'text-text-main font-bold' : 'text-text-muted font-medium'}`}>
        {item.name}
      </span>

      <!-- Description -->
      {item.description && (
        <span class="text-[11px] text-text-muted/70 pl-1 font-sans font-medium select-text shrink-0">
          — {item.description}
        </span>
      )}
    </div>
  ))}
</div>

