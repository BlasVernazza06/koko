---
import { FileText, ArrowRight, Settings, Cpu, Layers, ShieldCheck } from "@lucide/svelte";

const { lang = 'es' } = Astro.props;

const docsEn = [
  {
    id: "scaffolding",
    title: "Interactive Scaffolding",
    desc: "Scaffold clean, standardized repositories dynamically with our single-command interactive CLI helper.",
    path: "/docs#scaffolding"
  },
  {
    id: "presets",
    title: "Active Presets & Blueprints",
    desc: "Deploy production-proven architectures instantly using blueprints customized for SaaS, mobile apps, and fullstack frameworks.",
    path: "/docs#presets"
  },
  {
    id: "drift",
    title: "Drift Prevention",
    desc: "Keep your workspace parameters, linter configs, and dependencies synchronized and detect deviations from Day 1 to Day 2.",
    path: "/docs#drift"
  },
  {
    id: "offline",
    title: "Zero-dependency Engine",
    desc: "A fast, compiled Go binary that runs completely offline with zero configuration lock-in or extra npm bloat.",
    path: "/docs#offline"
  }
];

const docsEs = [
  {
    id: "scaffolding",
    title: "Estructuración Interactiva",
    desc: "Crea repositorios limpios y estandarizados dinámicamente con nuestro asistente interactivo CLI de un solo comando.",
    path: "/docs#scaffolding"
  },
  {
    id: "presets",
    title: "Recetas y Presets Activos",
    desc: "Despliega arquitecturas probadas en producción usando plantillas personalizadas para SaaS, apps móviles y frameworks fullstack.",
    path: "/docs#presets"
  },
  {
    id: "drift",
    title: "Control de Desviación (Drift)",
    desc: "Mantén sincronizados los parámetros, reglas del linter y dependencias de tu proyecto detectando cualquier desvío desde el inicio.",
    path: "/docs#drift"
  },
  {
    id: "offline",
    title: "Motor sin Dependencias",
    desc: "Un binario rápido compilado en Go que se ejecuta completamente offline sin permanencia de configuración ni sobrecarga de npm.",
    path: "/docs#offline"
  }
];

const docs = lang === 'es' ? docsEs : docsEn;
---

<section id="docs" class="w-full max-w-5xl px-4 py-16 mx-auto border-t border-border-subtle/60 select-none">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-xs font-semibold text-brand-primary tracking-wide uppercase">
        <FileText size={12} aria-hidden="true" />
        <span class="lang-es">Documentación del Proyecto</span>
        <span class="lang-en">Project Documentation</span>
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight text-text-main font-sans">
        <span class="lang-es">Explora la Documentación</span>
        <span class="lang-en">Explore the Docs</span>
      </h2>
      <p class="text-xs sm:text-sm text-text-muted leading-relaxed max-w-xl">
        <span class="lang-es">Domina todos los subcomandos, recetas y flujos de trabajo para elevar la ergonomía de tu equipo.</span>
        <span class="lang-en">Master all subcommands, blueprints and developer workflows to elevate your team's velocity.</span>
      </p>
    </div>

    <!-- Main Docs Link -->
    <a 
      href={lang === 'es' ? '/docs' : '/en/docs'} 
      class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-bg-surface hover:bg-bg-base border border-border-subtle hover:border-brand-primary/40 text-text-main font-bold text-xs sm:text-sm transition-all group shrink-0"
    >
      <span class="lang-es">Ir a Docs</span>
      <span class="lang-en">Go to Docs</span>
      <span class="group-hover:translate-x-0.5 transition-transform duration-200">&rarr;</span>
    </a>
  </div>

  <!-- Docs Grid Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {docs.map((item) => (
      <div class="relative group/doc-card rounded-2xl border border-border-subtle bg-bg-surface/30 hover:bg-bg-surface/50 backdrop-blur-xs p-6 shadow-sm hover:border-brand-primary/30 transition-all duration-300 flex flex-col justify-between">
        <div class="space-y-4">
          <!-- Icon selection matching ID -->
          <div class="w-10 h-10 rounded-xl bg-bg-base border border-border-subtle/50 flex items-center justify-center text-brand-primary group-hover/doc-card:text-brand-secondary transition-colors">
            {item.id === "scaffolding" && <Cpu size={20} />}
            {item.id === "presets" && <Layers size={20} />}
            {item.id === "drift" && <ShieldCheck size={20} />}
            {item.id === "offline" && <Settings size={20} />}
          </div>
          <div class="space-y-1.5">
            <h3 class="text-base font-bold text-text-main group-hover/doc-card:text-brand-primary transition-colors">{item.title}</h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed">{item.desc}</p>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-border-subtle/40 flex justify-end">
          <a 
            href={lang === 'es' ? item.path : `/en${item.path}`}
            class="inline-flex items-center gap-1 text-xs font-bold text-brand-primary group-hover/doc-card:text-brand-secondary transition-colors"
          >
            <span>Docs</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
