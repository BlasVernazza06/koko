---
import { SvglGoLogo } from '@selemondev/svgl-svelte';

const { lang = 'es' } = Astro.props;
---

<div class="md:col-span-3 group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-border-subtle bg-bg-surface/40 backdrop-blur-md p-6 sm:p-8 transition-all duration-300 hover:shadow-xl hover:shadow-brand-secondary/5 hover:border-brand-secondary/30">
  <div class="absolute inset-0 bg-gradient-to-tr from-brand-secondary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
  
  <!-- Visual Performance Mockup -->
  <div class="relative w-full mb-6 flex flex-col justify-end select-none overflow-visible pt-2">
    
    <!-- Top Header Label -->
    <div class="flex items-center justify-between mb-4 px-1">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
        <span class="text-[11px] font-medium tracking-wider text-text-muted uppercase">
          {lang === 'es' ? 'TIEMPO DE EJECUCIÓN' : 'EXECUTION TIME'}
        </span>
      </div>
      <span class="text-[10px] text-brand-primary font-mono font-semibold px-2.5 py-0.5 rounded-full bg-bg-surface border border-brand-primary">
        {lang === 'es' ? '100x más rápido' : '100x faster'}
      </span>
    </div>

    <!-- Y-Axis + Chart Container (Unified Grid Structure for 100% Centering) -->
    <div class="flex items-stretch gap-3 w-full relative">

      <!-- Y-Axis Scale (Left) -->
      <div class="relative flex flex-col justify-between text-[10px] font-mono text-text-muted/80 h-[140px] pr-3 shrink-0 border-r border-gray-500/30 select-none">
        <span>150ms</span>
        <span>100ms</span>
        <span>50ms</span>
        <span>0ms</span>
      </div>

      <!-- Main Chart & Badges Wrapper -->
      <div class="relative flex-1 flex flex-col">
        
        <!-- Chart Area (3 Columns Grid for Perfect Alignment) -->
        <div class="relative h-[140px] grid grid-cols-3 items-end justify-items-center">
          
          <!-- Visible Gray Dashed Grid Lines -->
          <div class="absolute inset-0 flex flex-col justify-between pointer-events-none">
            <div class="border-b border-dashed border-gray-500/40 w-full"></div>
            <div class="border-b border-dashed border-gray-500/40 w-full"></div>
            <div class="border-b border-dashed border-gray-500/40 w-full"></div>
          </div>
          <!-- Column 1: Node.js -->
          <div class="flex flex-col items-center justify-end h-full w-full relative group/tower cursor-pointer z-10">
            <!-- Metric above bar -->
            <span class="text-[11px] font-mono font-medium text-text-muted mb-1.5 transition-colors group-hover/tower:text-[#42b883]">
              120ms
            </span>

            <!-- Tooltip -->
            <div class="absolute bottom-[115px] left-1/2 -translate-x-1/2 w-44 p-3 bg-bg-surface border border-border-subtle rounded-2xl shadow-xl opacity-0 pointer-events-none group-hover/tower:opacity-100 transition-all duration-200 z-50">
              <p class="text-[11px] font-semibold text-text-main mb-1 flex items-center gap-1.5">
                <img src="/logos/nodejs.svg" alt="" class="w-3.5 h-3.5" /> Node.js CLI
              </p>
              <div class="flex flex-col gap-0.5 text-[10px] text-text-muted">
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Tiempo:' : 'Time:'}</span> 
                  <span class="font-mono text-text-main font-semibold">120ms</span>
                </div>
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Consumo:' : 'Memory:'}</span> 
                  <span class="font-mono">~35MB</span>
                </div>
              </div>
            </div>

            <!-- Warm Matte Bar with Subtle Node Green -->
            <div class="w-12 h-[105px] rounded-md bg-[#42b883]/5 border border-[#42b883]/20 hover:border-[#42b883]/45 hover:bg-[#42b883]/10 transition-all duration-300 shadow-sm flex items-center justify-center">
              <div class="w-full h-full rounded-[15px] stripe-node"></div>
            </div>
          </div>

          <!-- Column 2: Go Engine (Koko - Highlighted Warm Matte) -->
          <!-- Column 2: Go Engine (Koko - Highlighted Warm Go Cyan) -->
          <div class="flex flex-col items-center justify-end h-full w-full relative group/tower cursor-pointer z-10">
            <!-- Metric above bar -->
            <span class="text-[11px] font-mono font-extrabold text-[#00ADD8] mb-1.5 flex items-center gap-1">
              1.2ms
            </span>

            <!-- Tooltip -->
            <div class="absolute bottom-[35px] left-1/2 -translate-x-1/2 w-48 p-3 bg-bg-surface border border-[#00ADD8]/40 rounded-2xl shadow-xl opacity-0 pointer-events-none group-hover/tower:opacity-100 transition-all duration-200 z-50">
              <div class="flex items-center gap-1.5 mb-1">
                <img src="/logos/go.svg" alt="" class="w-4 h-4" />
                <p class="text-[11px] font-bold text-[#00ADD8]">Go Engine (Koko)</p>
              </div>
              <div class="flex flex-col gap-0.5 text-[10px] text-text-muted">
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Tiempo:' : 'Time:'}</span> 
                  <span class="font-mono text-[#00ADD8] font-bold">1.2ms (¡El mejor!)</span>
                </div>
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Consumo:' : 'Memory:'}</span> 
                  <span class="font-mono text-text-main">~1.5MB</span>
                </div>
              </div>
            </div>

            <!-- Solid Warm Go Cyan Bar -->
            <div class="w-12 h-[22px] rounded-md bg-[#00ADD8] border border-[#0092b8] shadow-sm hover:brightness-110 transition-all duration-300"></div>
          </div>

          <!-- Column 3: Rust -->
          <div class="flex flex-col items-center justify-end h-full w-full relative group/tower cursor-pointer z-10">
            <!-- Metric above bar -->
            <span class="text-[11px] font-mono font-medium text-text-muted mb-1.5 transition-colors group-hover/tower:text-[#e05d44]">
              2.1ms
            </span>

            <!-- Tooltip -->
            <div class="absolute bottom-[45px] left-1/2 -translate-x-1/2 w-44 p-3 bg-bg-surface border border-border-subtle rounded-2xl shadow-xl opacity-0 pointer-events-none group-hover/tower:opacity-100 transition-all duration-200 z-50">
              <p class="text-[11px] font-semibold text-text-main mb-1 flex items-center gap-1.5">
                <img src="/logos/rust.svg" alt="" class="w-3.5 h-3.5" /> Rust CLI
              </p>
              <div class="flex flex-col gap-0.5 text-[10px] text-text-muted">
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Tiempo:' : 'Time:'}</span> 
                  <span class="font-mono text-text-main font-semibold">2.1ms</span>
                </div>
                <div class="flex justify-between">
                  <span>{lang === 'es' ? 'Consumo:' : 'Memory:'}</span> 
                  <span class="font-mono">~2.4MB</span>
                </div>
              </div>
            </div>

            <!-- Warm Matte Bar with Subtle Rust Red -->
            <div class="w-12 h-[32px] rounded-md bg-[#e05d44]/5 border border-[#e05d44]/20 hover:border-[#e05d44]/45 hover:bg-[#e05d44]/10 transition-all duration-300 shadow-sm flex items-center justify-center">
              <div class="w-full h-full rounded-[11px] stripe-rust"></div>
            </div>
          </div>

        </div>

        <!-- Tech Badges Below Chart Grid (Guaranteed Perfect Centering via Grid 3 Cols) -->
        <div class="grid grid-cols-3 justify-items-center pt-4">
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-bg-surface/80 border border-border-subtle shadow-xs">
            <img src="/logos/nodejs.svg" alt="Node.js" class="w-3.5 h-3.5 object-contain" />
            <span class="text-[11px] font-medium text-text-muted">Node</span>
          </div>

          <!-- Highlighted Go Cyan Winner Badge -->
          <div class="flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#00ADD8] text-white font-bold border border-[#0092b8] shadow-md shadow-[#00ADD8]/20 scale-105">
            <img src="/logos/go.svg" alt="Go" class="w-3.5 h-3.5 object-contain brightness-0 invert" />
            <span class="text-[11px]">Go (Koko)</span>
          </div>

          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-bg-surface/80 border border-border-subtle shadow-xs">
            <img src="/logos/rust.svg" alt="Rust" class="w-3.5 h-3.5 object-contain" />
            <span class="text-[11px] font-semibold text-[#e05d44]">Rust</span>
          </div>
        </div>

      </div>
    </div>

  </div>
  
  <!-- Card Copy -->
  <div class="mt-auto relative z-15 select-none">
    <div class="flex items-center gap-2 mb-2">
      <div class="w-1 h-4 bg-brand-secondary rounded-full"></div>
      <h3 class="text-lg font-bold text-text-main lang-es">Performance superior</h3>
      <h3 class="text-lg font-bold text-text-main lang-en">Superior Perfomance</h3>
    </div>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed lang-es align-middle">
      CLI tool creada en <span class="inline-block align-middle mx-1"><SvglGoLogo width={30} height={10} class="text-[#00ADD8] fill-current [&_g]:fill-current" /></span>, con un rendimiento y velocidades de carga instantáneas
    </p>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed lang-en">
      Configure backend models, frontend rendering methods, databases, and linters visually and interactively.
    </p>
  </div>
</div>

<style>
  .stripe-node {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 4px,
      rgba(66, 184, 131, 0.12) 4px,
      rgba(66, 184, 131, 0.12) 8px
    );
  }
  .stripe-rust {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 4px,
      rgba(224, 93, 68, 0.12) 4px,
      rgba(224, 93, 68, 0.12) 8px
    );
  }
</style>
