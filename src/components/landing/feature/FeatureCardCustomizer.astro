---
const { lang = 'es' } = Astro.props;
---

<div class="md:col-span-3 group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-border-subtle bg-bg-surface/40 backdrop-blur-md p-6 sm:p-8 transition-all duration-300 hover:shadow-xl hover:shadow-brand-primary/5 hover:border-brand-primary/30">
  <div class="absolute inset-0 bg-gradient-to-tr from-brand-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

  <!-- Card Visual: Pipeline Stepper -->
  <div class="relative w-full mb-6 select-none overflow-hidden rounded-2xl border border-border-subtle bg-bg-surface/90 p-4 shadow-inner">

    <!-- Terminal bar / Window Header -->
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-border-subtle/40">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-[#ff5f57] opacity-80"></span>
        <span class="w-3 h-3 rounded-full bg-[#febc2e] opacity-80"></span>
        <span class="w-3 h-3 rounded-full bg-[#28c840] opacity-80"></span>
        <span class="ml-2 text-[11px] font-mono text-text-muted/70 tracking-wider">koko init</span>
      </div>
      <div class="text-[10px] font-mono text-text-muted/40">bash</div>
    </div>

    <!-- Pipeline Steps Container -->
    <div class="pipeline-wrapper relative flex flex-col gap-1.5 text-[12px] font-sans">

      <!-- Connector line (left border) -->
      <div class="absolute left-[30px] top-[26px] bottom-[26px] w-[2px] bg-gradient-to-b from-brand-primary/45 via-brand-primary/20 to-transparent pointer-events-none z-0"></div>

      <!-- Step 1: Initializing -->
      <div class="pipeline-step step-1 relative flex items-center gap-3 px-3 py-2 rounded-xl transition-all duration-300">
        <div class="step-icon relative z-10 w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border transition-all duration-500">
          <!-- Spinner (active state) -->
          <svg class="step-spinner absolute w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="6"></line>
            <line x1="12" y1="18" x2="12" y2="22"></line>
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
            <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
            <line x1="2" y1="12" x2="6" y2="12"></line>
            <line x1="18" y1="12" x2="22" y2="12"></line>
            <line x1="6.34" y1="17.66" x2="9.17" y2="14.83"></line>
            <line x1="14.83" y1="9.17" x2="17.66" y2="6.34"></line>
          </svg>
          <!-- Lucide Check (done state) -->
          <svg class="step-check absolute w-5 h-5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col justify-center">
          <span class="step-label text-text-muted/50 font-semibold text-[13px] tracking-tight leading-none transition-colors duration-500">
            {lang === 'es' ? 'Inicializando proyecto' : 'Initializing project'}
          </span>
          <span class="step-detail text-text-muted/70 text-[11px] mt-1 opacity-0 transition-opacity duration-300">
            {lang === 'es' ? 'Leyendo configuración local...' : 'Reading local config...'}
          </span>
        </div>
        <span class="step-time ml-auto self-center text-[10px] font-mono opacity-0 transition-opacity duration-300 shrink-0 bg-border-subtle/30 px-1.5 py-0.5 rounded text-text-muted">0.3ms</span>
      </div>

      <!-- Step 2: Installing -->
      <div class="pipeline-step step-2 relative flex items-center gap-3 px-3 py-2 rounded-xl transition-all duration-300">
        <div class="step-icon relative z-10 w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border transition-all duration-500">
          <svg class="step-spinner absolute w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="6"></line>
            <line x1="12" y1="18" x2="12" y2="22"></line>
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
            <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
            <line x1="2" y1="12" x2="6" y2="12"></line>
            <line x1="18" y1="12" x2="22" y2="12"></line>
            <line x1="6.34" y1="17.66" x2="9.17" y2="14.83"></line>
            <line x1="14.83" y1="9.17" x2="17.66" y2="6.34"></line>
          </svg>
          <svg class="step-check absolute w-5 h-5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col justify-center">
          <span class="step-label text-text-muted/50 font-semibold text-[13px] tracking-tight leading-none transition-colors duration-500">
            {lang === 'es' ? 'Instalando dependencias' : 'Installing dependencies'}
          </span>
          <span class="step-detail text-text-muted/70 text-[11px] mt-1 opacity-0 transition-opacity duration-300">
            {lang === 'es' ? 'Resolviendo paquetes offline...' : 'Resolving packages offline...'}
          </span>
        </div>
        <span class="step-time ml-auto self-center text-[10px] font-mono opacity-0 transition-opacity duration-300 shrink-0 bg-border-subtle/30 px-1.5 py-0.5 rounded text-text-muted">0.8ms</span>
      </div>

      <!-- Step 3: Configuring -->
      <div class="pipeline-step step-3 relative flex items-center gap-3 px-3 py-2 rounded-xl transition-all duration-300">
        <div class="step-icon relative z-10 w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border transition-all duration-500">
          <svg class="step-spinner absolute w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="6"></line>
            <line x1="12" y1="18" x2="12" y2="22"></line>
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
            <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
            <line x1="2" y1="12" x2="6" y2="12"></line>
            <line x1="18" y1="12" x2="22" y2="12"></line>
            <line x1="6.34" y1="17.66" x2="9.17" y2="14.83"></line>
            <line x1="14.83" y1="9.17" x2="17.66" y2="6.34"></line>
          </svg>
          <svg class="step-check absolute w-5 h-5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col justify-center">
          <span class="step-label text-text-muted/50 font-semibold text-[13px] tracking-tight leading-none transition-colors duration-500">
            {lang === 'es' ? 'Configurando stack' : 'Configuring stack'}
          </span>
          <span class="step-detail text-text-muted/70 text-[11px] mt-1 opacity-0 transition-opacity duration-300">
            {lang === 'es' ? 'Aplicando boilerplate...' : 'Applying boilerplate...'}
          </span>
        </div>
        <span class="step-time ml-auto self-center text-[10px] font-mono opacity-0 transition-opacity duration-300 shrink-0 bg-border-subtle/30 px-1.5 py-0.5 rounded text-text-muted">0.4ms</span>
      </div>

      <!-- Step 4: Ready -->
      <div class="pipeline-step step-4 relative flex items-center gap-3 px-3 py-2 rounded-xl transition-all duration-300">
        <div class="step-icon relative z-10 w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border transition-all duration-500">
          <svg class="step-spinner absolute w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="6"></line>
            <line x1="12" y1="18" x2="12" y2="22"></line>
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
            <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
            <line x1="2" y1="12" x2="6" y2="12"></line>
            <line x1="18" y1="12" x2="22" y2="12"></line>
            <line x1="6.34" y1="17.66" x2="9.17" y2="14.83"></line>
            <line x1="14.83" y1="9.17" x2="17.66" y2="6.34"></line>
          </svg>
          <svg class="step-check absolute w-5 h-5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col justify-center">
          <span class="step-label text-text-muted/50 font-semibold text-[13px] tracking-tight leading-none transition-colors duration-500">
            {lang === 'es' ? 'Proyecto listo 🎉' : 'Project ready 🎉'}
          </span>
          <span class="step-detail text-text-muted/70 text-[11px] mt-1 opacity-0 transition-opacity duration-300">
            {lang === 'es' ? '¡Todo en orden!' : 'Everything ready!'}
          </span>
        </div>
        <span class="step-time ml-auto self-center text-[10px] font-mono opacity-0 transition-opacity duration-300 shrink-0 text-brand-primary font-bold bg-brand-primary/10 border border-brand-primary/30 px-1.5 py-0.5 rounded">1.5ms</span>
      </div>

    </div>
  </div>

  <!-- Card Copy -->
  <div class="mt-auto relative z-15 select-none">
    <div class="flex items-center gap-2 mb-2">
      <div class="w-1 h-4 bg-brand-secondary rounded-full"></div>
      <h3 class="text-lg font-bold text-text-main lang-es">Pipelines de Generación</h3>
      <h3 class="text-lg font-bold text-text-main lang-en">Generation Pipelines</h3>
    </div>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed lang-es">
      Koko ejecuta pasos secuenciales al crear tu proyecto: inicializa, instala, configura y entrega todo listo en milisegundos.
    </p>
    <p class="text-xs sm:text-sm text-text-muted leading-relaxed lang-en">
      Koko runs sequential steps when scaffolding your project: initializes, installs, configures, and delivers everything ready in milliseconds.
    </p>
  </div>
</div>

<style>
  /* ─── Color tokens for steps ─── */
  .step-icon {
    color: var(--text-muted);
    border-color: color-mix(in srgb, currentColor 15%, transparent);
    background: var(--bg-surface); /* Solid background to mask vertical line */
  }

  /* ─── Active step: brand-primary glow ─── */
  .pipeline-step.is-active .step-icon {
    color: var(--brand-primary);
    border-color: color-mix(in srgb, var(--brand-primary) 35%, transparent);
    background: var(--bg-surface); /* Keep solid, only mix colors if desired but solid prevents line transparency */
    box-shadow: 0 0 14px color-mix(in srgb, var(--brand-primary) 25%, transparent);
  }
  .pipeline-step.is-active .step-label {
    color: var(--text-main) !important;
    opacity: 1 !important;
  }
  .pipeline-step.is-active .step-detail,
  .pipeline-step.is-active .step-time {
    opacity: 1 !important;
  }
  .pipeline-step.is-active {
    background: color-mix(in srgb, var(--brand-primary) 4%, transparent);
  }

  /* Active: show spinner, hide check */
  .pipeline-step.is-active .step-spinner {
    display: block;
    animation: spin 1s linear infinite;
  }
  .pipeline-step.is-active .step-check {
    opacity: 0 !important;
  }

  /* ─── Done step: solid strong green ─── */
  .pipeline-step.is-done .step-icon {
    color: #ffffff;
    border-color: #10b981;
    background: #10b981; /* Strong green background without opacity */
  }
  .pipeline-step.is-done .step-label {
    color: var(--text-muted) !important;
    opacity: 0.8 !important;
  }
  .pipeline-step.is-done .step-detail,
  .pipeline-step.is-done .step-time {
    opacity: 1 !important;
  }
  .pipeline-step.is-done .step-detail {
    color: #10b981 !important; /* Standard text color to match */
  }

  /* Done: hide spinner, show check */
  .pipeline-step.is-done .step-spinner {
    display: none;
  }
  .pipeline-step.is-done .step-check {
    opacity: 1 !important;
    animation: check-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  /* ─── Step-4 done gets brand-primary accent ─── */
  .pipeline-step.step-4.is-done .step-icon {
    color: #ffffff;
    border-color: var(--brand-primary);
    background: var(--brand-primary); /* Strong primary brand color without opacity */
  }
  .pipeline-step.step-4.is-done .step-label {
    color: var(--text-main) !important;
    opacity: 1 !important;
  }
  .pipeline-step.step-4.is-done .step-time {
    color: var(--brand-primary) !important;
    opacity: 1 !important;
  }

  /* ─── Keyframes ─── */
  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes check-pop {
    0%   { transform: scale(0.4); opacity: 0; }
    60%  { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(1);   opacity: 1; }
  }
</style>

<script>
  (function () {
    const STEPS = [
      { sel: '.step-1', activeAt: 0,    doneAt: 1200 },
      { sel: '.step-2', activeAt: 1300, doneAt: 2600 },
      { sel: '.step-3', activeAt: 2700, doneAt: 3900 },
      { sel: '.step-4', activeAt: 4000, doneAt: 5200 },
    ];
    const CYCLE = 7000;

    function runCycle(wrapper: Element) {
      STEPS.forEach(({ sel }) => {
        const el = wrapper.querySelector(sel);
        if (el) {
          el.classList.remove('is-active', 'is-done');
        }
      });

      STEPS.forEach(({ sel, activeAt, doneAt }) => {
        setTimeout(() => {
          const el = wrapper.querySelector(sel);
          if (el) el.classList.add('is-active');
        }, activeAt);

        setTimeout(() => {
          const el = wrapper.querySelector(sel);
          if (el) {
            el.classList.remove('is-active');
            el.classList.add('is-done');
          }
        }, doneAt);
      });
    }

    function init() {
      document.querySelectorAll('.pipeline-wrapper').forEach((wrapper) => {
        runCycle(wrapper);
        setInterval(() => runCycle(wrapper), CYCLE);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
