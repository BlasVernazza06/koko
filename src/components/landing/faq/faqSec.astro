---
import { ChevronDown, Plus, Minus } from "@lucide/svelte";
import { faqsEn, faqsEs } from "./faqData";
import { ArrowUpRight } from "@lucide/astro";

const { lang = 'es' } = Astro.props;
const faqs = lang === 'es' ? faqsEs : faqsEn;

const labels = lang === 'es' ? {
  badge: "FAQ",
  title: "Preguntas Frecuentes",
  subtitle: "Hemos recopilado una lista de respuestas para abordar tus preguntas más urgentes sobre nuestros servicios.",
  all: "General", // fallback to General, or show categories
  general: "General",
  features: "Características del Producto",
  integration: "Integración y Soporte",
  security: "Seguridad",
  stillHaveQuestions: "¿Aún tienes preguntas?",
  stillHaveQuestionsSub: "¡Por favor contáctate con nuestro equipo de soporte, estaremos encantados de ayudarte!",
  contactSupport: "Soporte"
} : {
  badge: "FAQ",
  title: "Frequently Asked Questions",
  subtitle: "We compiled a list of answers to address your most pressing questions regarding our Services.",
  all: "General",
  general: "General",
  features: "Product Features",
  integration: "Integration & Support",
  security: "Security",
  stillHaveQuestions: "Still have questions?",
  stillHaveQuestionsSub: "Please connect with our support team, we're happy to help!",
  contactSupport: "Support"
};
---

<section id="faq" class="w-full max-w-6xl px-6 py-24 mx-auto font-sans">
  <!-- Top Badge -->
  <div class="text-center mb-4">
    <span class="text-xs font-bold text-brand-primary tracking-widest uppercase">
      {labels.badge}
    </span>
  </div>

  <!-- Title & Subtitle -->
  <div class="text-center mb-16 max-w-2xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-text-main tracking-tight mb-4 leading-tight">
      {labels.title}
    </h2>
    <p class="text-sm text-text-muted">
      {labels.subtitle}
    </p>
  </div>

  <!-- Two Column Layout -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
    
    <!-- Sidebar Navigation -->
    <div class="md:col-span-3 space-y-2">
      <nav class="flex flex-col gap-1" id="faq-categories">
        <button 
          data-category="general"
          class="faq-cat-btn flex items-center w-full px-4 py-2.5 rounded-xl text-left text-sm font-bold transition-all duration-200 cursor-pointer select-none bg-bg-surface/50 text-text-main"
        >
          {labels.general}
        </button>
        <button 
          data-category="features"
          class="faq-cat-btn flex items-center w-full px-4 py-2.5 rounded-xl text-left text-sm font-bold transition-all duration-200 cursor-pointer select-none text-text-muted hover:text-text-main hover:bg-bg-surface/30"
        >
          {labels.features}
        </button>
        <button 
          data-category="integration"
          class="faq-cat-btn flex items-center w-full px-4 py-2.5 rounded-xl text-left text-sm font-bold transition-all duration-200 cursor-pointer select-none text-text-muted hover:text-text-main hover:bg-bg-surface/30"
        >
          {labels.integration}
        </button>
        <button 
          data-category="security"
          class="faq-cat-btn flex items-center w-full px-4 py-2.5 rounded-xl text-left text-sm font-bold transition-all duration-200 cursor-pointer select-none text-text-muted hover:text-text-main hover:bg-bg-surface/30"
        >
          {labels.security}
        </button>
      </nav>
    </div>

    <!-- Accordion List Column -->
    <div class="md:col-span-9 space-y-6">
      
      <div class="border-t border-border-subtle/50 divide-y divide-border-subtle/50" id="faq-list">
        {faqs.map((faq) => (
          <div 
            class="faq-item py-4 transition-all duration-300"
            data-category={faq.category}
          >
            <button 
              class="faq-trigger flex items-center justify-between w-full text-left font-bold text-sm sm:text-base text-text-main transition-colors duration-250 cursor-pointer py-2"
              aria-expanded="false"
            >
              <span>{faq.question}</span>
              <span class="faq-icon-wrapper text-text-muted ml-4 relative w-4.5 h-4.5 flex items-center justify-center shrink-0">
                <Plus size={16} class="faq-icon-plus absolute" />
                <Minus size={16} class="faq-icon-minus absolute" />
              </span>
            </button>
            
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="pt-2 pb-1 text-xs sm:text-sm text-text-muted leading-relaxed max-w-3xl">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Support call-out card -->
      <div class="bg-bg-surface/20 border border-border-subtle/40 rounded-3xl p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mt-8">
        <div>
          <h4 class="text-base font-extrabold text-text-main">
            {labels.stillHaveQuestions}
          </h4>
          <p class="text-xs sm:text-sm text-text-muted mt-1">
            {labels.stillHaveQuestionsSub}
          </p>
        </div>
        <div>
          <a 
            href="mailto:support@credenza.dev" 
            class="flex items-center justify-center px-5 py-2.5 border border-border-subtle bg-bg-surface hover:bg-bg-surface/80 text-text-main hover:text-brand-primary text-xs sm:text-sm font-bold rounded-xl transition-all duration-200 shadow-xs cursor-pointer select-none"
          >
            {labels.contactSupport}
            <ArrowUpRight width={20} height={20}/>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .faq-icon-plus {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faq-icon-minus {
    opacity: 0;
    transform: rotate(-90deg) scale(0.7);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(.faq-item.faq-open) .faq-icon-plus {
    opacity: 0;
    transform: rotate(90deg) scale(0.7);
  }
  :global(.faq-item.faq-open) .faq-icon-minus {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  function initFaqHub() {
    const faqSection = document.getElementById('faq');
    if (!faqSection || faqSection.getAttribute('data-faq-initialized') === 'true') return;
    faqSection.setAttribute('data-faq-initialized', 'true');

    const catButtons = document.querySelectorAll('.faq-cat-btn');
    const faqItems = document.querySelectorAll('.faq-item');
    let activeCategory = 'general';

    // Show initial category
    updateFaqFilters();

    // Category Selector logic
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'general';
        activeCategory = cat;
        
        // Reset styles for all buttons
        catButtons.forEach(b => {
          b.className = "faq-cat-btn flex items-center w-full px-4 py-2.5 rounded-xl text-left text-sm font-bold transition-all duration-200 cursor-pointer select-none text-text-muted hover:text-text-main hover:bg-bg-surface/30";
        });
        
        // Apply active styles to selected button
        btn.className = "faq-cat-btn flex items-center w-full px-4 py-2.5 rounded-xl text-left text-sm font-bold transition-all duration-200 cursor-pointer select-none bg-bg-surface/50 text-text-main";
        
        updateFaqFilters();
      });
    });

    // Accordion expand/collapse logic
    faqSection.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.faq-trigger');
      if (!trigger) return;

      const item = trigger.closest('.faq-item');
      if (!item) return;

      const content = item.querySelector('.faq-content') as HTMLElement | null;
      if (!content) return;

      const isOpen = item.classList.contains('faq-open');
      
      // Close other items for accordion effect
      faqItems.forEach(otherItem => {
        if (otherItem !== item && otherItem.classList.contains('faq-open')) {
          otherItem.classList.remove('faq-open');
          const otherContent = otherItem.querySelector('.faq-content') as HTMLElement | null;
          if (otherContent) otherContent.style.maxHeight = '0px';
        }
      });

      if (isOpen) {
        item.classList.remove('faq-open');
        content.style.maxHeight = '0px';
      } else {
        item.classList.add('faq-open');
        content.style.maxHeight = content.scrollHeight + 'px';
      }
    });

    function updateFaqFilters() {
      faqItems.forEach(item => {
        const category = item.getAttribute('data-category') || '';
        const matchesCategory = category === activeCategory;

        if (matchesCategory) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
          
          // Collapse if active query changes and it was open
          if (item.classList.contains('faq-open')) {
            item.classList.remove('faq-open');
            const content = item.querySelector('.faq-content') as HTMLElement | null;
            if (content) content.style.maxHeight = '0px';
          }
        }
      });
    }
  }

  // Bind to DOM loaded and Astro router events
  document.addEventListener('DOMContentLoaded', initFaqHub);
  initFaqHub();
  document.addEventListener('astro:after-swap', initFaqHub);
</script>


