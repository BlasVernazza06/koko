---
import { Copy, Check, ArrowUpRight, Terminal, FileText } from "@lucide/svelte";
---

<section id="cta" class="w-full max-w-5xl px-4 py-16 mx-auto">
  <!-- Glowing container card -->
  <div class="relative overflow-hidden rounded-3xl border border-border-subtle bg-bg-surface/50 backdrop-blur-md px-6 py-12 sm:px-12 sm:py-16 text-center shadow-xl shadow-brand-primary/5">
    
    <!-- Background glowing auras (Tech aesthetic) -->
    <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden select-none">
      <div class="absolute -top-1/2 -left-1/4 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] rounded-full bg-brand-primary/10 blur-[80px] sm:blur-[120px] opacity-75"></div>
      <div class="absolute -bottom-1/2 -right-1/4 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] rounded-full bg-brand-secondary/10 blur-[80px] sm:blur-[120px] opacity-75"></div>
    </div>

    <!-- Content -->
    <div class="max-w-2xl mx-auto space-y-6 sm:space-y-8">
      
      <!-- Tiny Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-xs font-semibold text-brand-primary tracking-wide uppercase select-none">
        <span>Start Building</span>
      </div>

      <!-- Heading -->
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-text-main font-sans leading-tight">
        Ready to unify your <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-brand-primary to-brand-secondary bg-clip-text text-transparent">development workflow?</span>
      </h2>

      <!-- Subtitle -->
      <p class="text-xs sm:text-sm md:text-base text-text-muted leading-relaxed max-w-lg mx-auto">
        Join hundreds of engineers who scaffold clean, standardized, production-ready repositories in seconds. Zero configuration drift, maximum speed.
      </p>

      <!-- Copy Command Widget inside CTA -->
      <div class="w-full flex flex-col sm:flex-row gap-3 max-w-md mx-auto font-mono text-xs items-center justify-center">
        <div class="flex items-center justify-between gap-3 bg-bg-base border border-border-subtle p-3.5 rounded-xl group hover:border-brand-primary/30 transition-colors w-full sm:w-auto">
          <div class="flex items-center gap-2 text-text-muted">
            <Terminal size={14} class="text-brand-primary" />
            <span id="cta-install-cmd" class="select-all text-[11px] sm:text-xs text-text-main font-semibold">go install github.com/BlasVernazza06/claw@latest</span>
          </div>
          
          <button 
            id="cta-copy-btn" 
            class="p-1.5 rounded-lg border border-border-subtle bg-bg-surface hover:bg-bg-base transition-colors cursor-pointer text-text-muted hover:text-text-main active:scale-95 flex items-center justify-center animate-none"
            aria-label="Copy installation command"
          >
            <span id="cta-copy-icon"><Copy size={13} /></span>
            <span id="cta-check-icon" class="hidden text-brand-primary"><Check size={13} /></span>
          </button>
        </div>
        <a 
          href="#" 
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-brand-primary hover:bg-brand-primary/95 tracking-wide border border-border-subtle text-text-main font-bold text-sm text-center transition-all cursor-pointer flex items-center justify-center gap-1.5 hover:translate-y-[-2px] active:translate-y-[0]"
        >
          <FileText size={14}/>
          <span>Docs</span>
          <ArrowUpRight size={14} class="text-text-main" />
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Copy command functionality -->
<script>
  function initCtaCopy() {
    const copyBtn = document.getElementById('cta-copy-btn');
    const copyIcon = document.getElementById('cta-copy-icon');
    const checkIcon = document.getElementById('cta-check-icon');
    const installCmd = document.getElementById('cta-install-cmd');

    if (copyBtn && installCmd) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(installCmd.textContent || '');
          
          // Switch icons
          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
            
            setTimeout(() => {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initCtaCopy);
  initCtaCopy();
</script>
