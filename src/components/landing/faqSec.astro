---
import { ChevronDown, HelpCircle } from "@lucide/svelte";

const faqsEn = [
  {
    question: "What is Koko and how does it speed up development?",
    answer: "Koko is an interactive Visual Stack Builder and CLI designed to customize, scaffold, and bootstrap project repositories. It eliminates Day 1 configuration friction and helps you scale your app structure with ease."
  },
  {
    question: "How does the visual recipe generator work?",
    answer: "It lets you choose frontend, backend, ORM, database, payments, and quality tools dynamically. Koko computes dependencies reactively, renders the folder structure, and compiles a single init command."
  },
  {
    question: "Does Koko support monorepos using Turborepo?",
    answer: "Yes, Koko is monorepo-ready. You can scaffold multi-package structures with nested workspaces, global linters, and configurations, all pre-configured under a Turborepo environment in seconds."
  },
  {
    question: "Can I add tools like Docker, Vitest, or Biome to the recipe?",
    answer: "Absolutely. You can toggle local Docker Compose setups, Vitest configurations, and standard Biome linter parameters. They compile natively into the configuration files generated for your project."
  }
];

const faqsEs = [
  {
    question: "¿Qué es Koko y cómo acelera el desarrollo?",
    answer: "Koko es un generador visual de stacks y CLI diseñado para personalizar e inicializar repositorios de proyectos. Elimina la fricción de configuración del Día 1 y te ayuda a escalar la estructura fácilmente."
  },
  {
    question: "¿Cómo funciona el generador visual de recetas?",
    answer: "Te permite elegir dinámicamente tu frontend, backend, ORM, base de datos, pasarelas de pago y herramientas. Koko calcula las dependencias, renderiza la estructura de carpetas y compila un comando único."
  },
  {
    question: "¿Soporta Koko la creación de monorepos con Turborepo?",
    answer: "Sí, Koko viene listo para monorepos. Puedes estructurar esquemas multi-paquete con espacios de trabajo anidados, linters globales y configuraciones listas para escalar bajo un entorno de Turborepo."
  },
  {
    question: "¿Puedo añadir Docker, Vitest o Biome directamente en la receta?",
    answer: "Por supuesto. Puedes activar contenedores locales de Docker Compose, configuraciones de pruebas en Vitest y parámetros de Biome. Se compilan nativamente dentro de los archivos de configuración del proyecto."
  }
];

const { lang = 'es' } = Astro.props;
const faqs = lang === 'es' ? faqsEs : faqsEn;
---

<section id="faq" class="w-full max-w-4xl px-4 py-16 mx-auto border-t border-border-subtle/60">
  <!-- Section Header -->
  <div class="text-center mb-12 flex flex-col items-center">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 mb-3 rounded-full bg-brand-secondary/10 border border-brand-secondary/20 text-xs font-semibold text-brand-secondary tracking-wide uppercase select-none">
      <HelpCircle size={12} aria-hidden="true" />
      <span class="lang-es">Dudas Frecuentes</span>
      <span class="lang-en">Common Doubts</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text-main font-sans">
      <span class="lang-es">Preguntas Frecuentes</span>
      <span class="lang-en">Frequently Asked Questions</span>
    </h2>
    <p class="text-xs sm:text-sm text-text-muted mt-2">
      <span class="lang-es">Todo lo que necesitas saber sobre cómo configurar y sincronizar las reglas de tu código.</span>
      <span class="lang-en">Everything you need to know about setting up and syncing your team's code rules.</span>
    </p>
  </div>

  <!-- Accordion List -->
  <div class="space-y-4">
    {faqs.map((faq, index) => (
      <div class="faq-item border border-border-subtle bg-bg-surface/30 backdrop-blur-sm rounded-2xl overflow-hidden transition-all duration-300 hover:border-brand-primary/20">
        <button 
          class="faq-trigger flex items-center justify-between w-full p-5 text-left font-sans text-sm sm:text-base font-bold text-text-main hover:text-brand-primary transition-colors cursor-pointer select-none"
          data-index={index}
          aria-expanded="false"
        >
          <span>{faq.question}</span>
          <span class="faq-icon text-text-muted transition-transform duration-300">
            <ChevronDown size={18} aria-hidden="true" />
          </span>
        </button>
        
        <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
          <div class="p-5 pt-1 text-xs sm:text-sm text-text-muted leading-relaxed border-t border-border-subtle/40 bg-bg-base/30">
            {faq.answer}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  function initFaqAccordions() {
    const wrapper = document.querySelector('#faq .space-y-4');
    if (!wrapper || wrapper.getAttribute('data-faq-initialized') === 'true') return;
    wrapper.setAttribute('data-faq-initialized', 'true');

    wrapper.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.faq-trigger');
      if (!trigger) return;

      const item = trigger.closest('.faq-item');
      const content = item?.querySelector('.faq-content') as HTMLElement;
      const icon = item?.querySelector('.faq-icon');
      
      if (!content || !item) return;

      // Toggle state
      const isOpen = item.classList.contains('faq-open');
      
      // Close all other FAQs for clean single-accordion behavior
      wrapper.querySelectorAll('.faq-item').forEach(otherItem => {
        if (otherItem !== item && otherItem.classList.contains('faq-open')) {
          otherItem.classList.remove('faq-open');
          const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
          const otherIcon = otherItem.querySelector('.faq-icon');
          if (otherContent) otherContent.style.maxHeight = '0px';
          if (otherIcon) otherIcon.classList.remove('rotate-180');
        }
      });

      if (isOpen) {
        item.classList.remove('faq-open');
        content.style.maxHeight = '0px';
        if (icon) icon.classList.remove('rotate-180');
      } else {
        item.classList.add('faq-open');
        content.style.maxHeight = content.scrollHeight + 'px';
        if (icon) icon.classList.add('rotate-180');
      }
    });
  }

  // Trigger setup
  document.addEventListener('DOMContentLoaded', initFaqAccordions);
  initFaqAccordions();
  document.addEventListener('astro:after-swap', initFaqAccordions);
</script>
