---
import Logo from '../header/logo.astro';

const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';

const content = {
  es: {
    tagline: 'Inicialización de proyectos ultra rápida y evolutiva.',
    description: 'Koko es un motor de scaffolding rápido y minimalista escrito en Go para inicializar tus proyectos en segundos con la mejor experiencia de desarrollo.',
    docs: 'Documentación',
    quickStart: 'Inicio Rápido',
    commands: 'Comandos CLI',
    config: 'Configuración',
    faq: 'Preguntas Frecuentes',
    tools: 'Herramientas',
    builder: 'Constructor Interactivo',
    recipes: 'Recetas (SaaS / Fullstack)',
    community: 'Comunidad',
    github: 'Repositorio GitHub',
    npm: 'Paquete NPM',
    contributing: 'Colaborar',
    privacy: 'Política de Privacidad',
    terms: 'Términos de Servicio',
    rights: 'Todos los derechos reservados.',
    crafted: 'Creado con'
  },
  en: {
    tagline: 'Ultra-fast and evolutionary project scaffolding.',
    description: 'Koko is a fast, lightweight project scaffolding CLI engine written in Go to bootstrap your stack in seconds with the best developer ergonomics.',
    docs: 'Documentation',
    quickStart: 'Quick Start',
    commands: 'CLI Commands',
    config: 'Configuration',
    faq: 'FAQ',
    tools: 'Tools',
    builder: 'Interactive Builder',
    recipes: 'Recipes (SaaS / Fullstack)',
    community: 'Community',
    github: 'GitHub Repository',
    npm: 'NPM Package',
    contributing: 'Contributing',
    privacy: 'Privacy Policy',
    terms: 'Terms of Service',
    rights: 'All rights reserved.',
    crafted: 'Crafted with'
  }
};

const t = content[currentLang];
const langPrefix = currentLang === 'en' ? '/en' : '';
---

<footer class="border-t border-border-subtle/50 pt-16 pb-12 bg-linear-to-b from-bg-base to-bg-surface/30 relative overflow-hidden">
  <!-- Decorative background glow -->
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-brand-secondary/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-6 pb-12 border-b border-border-subtle/40">
      
      <!-- Brand & Tagline Section -->
      <div class="md:col-span-5 flex flex-col gap-4">
        <Logo />
        <p class="text-sm font-semibold text-brand-primary mt-2">
          {t.tagline}
        </p>
        <p class="text-[13px] text-text-muted leading-relaxed max-w-sm">
          {t.description}
        </p>
        
        <!-- Socials -->
        <div class="flex items-center gap-3 mt-4">
          <a 
            href="https://github.com/BlasVernazza06/koko-cli" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="group/social p-2.5 rounded-lg bg-bg-surface/50 border border-border-subtle/40 text-text-muted hover:text-text-main dark:text-white dark:hover:text-white hover:border-brand-primary/30 transition-all duration-300"
            aria-label="GitHub Repository"
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current text-current dark:text-white group-hover/social:scale-110 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:col-span-7 gap-8">
        
        <!-- Documentation Column -->
        <div class="flex flex-col gap-4">
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-brand-primary/80">
            {t.docs}
          </h3>
          <ul class="flex flex-col gap-2.5">
            <li>
              <a href={`${langPrefix}/docs/quick-start`} class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.quickStart}
              </a>
            </li>
            <li>
              <a href={`${langPrefix}/docs/cli-commands`} class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.commands}
              </a>
            </li>
            <li>
              <a href={`${langPrefix}/docs/claw-config`} class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.config}
              </a>
            </li>
            <li>
              <a href={`${langPrefix}/docs/faq`} class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.faq}
              </a>
            </li>
          </ul>
        </div>

        <!-- Tools Column -->
        <div class="flex flex-col gap-4">
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-brand-primary/80">
            {t.tools}
          </h3>
          <ul class="flex flex-col gap-2.5">
            <li>
              <a href={`${langPrefix}/builder`} class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.builder}
              </a>
            </li>
            <li>
              <a href={`${langPrefix}/#recipes`} class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.recipes}
              </a>
            </li>
          </ul>
        </div>

        <!-- Community Column -->
        <div class="flex flex-col gap-4 col-span-2 sm:col-span-1">
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-brand-primary/80">
            {t.community}
          </h3>
          <ul class="flex flex-col gap-2.5">
            <li>
              <a href="https://github.com/BlasVernazza06/koko-cli" target="_blank" rel="noopener noreferrer" class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.github}
              </a>
            </li>
            <li>
              <a href={`${langPrefix}/docs/contributing`} class="text-[13px] text-text-muted hover:text-brand-primary hover:translate-x-1 inline-flex items-center gap-1 transition-all duration-300">
                {t.contributing}
              </a>
            </li>
          </ul>
        </div>

      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-8 text-[12px] text-text-muted">
      
      <!-- Copyright -->
      <div>
        © {new Date().getFullYear()} Claw CLI. {t.rights}
      </div>

      <!-- Made with 🐨 and links -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <span class="inline-flex items-center gap-1 select-none">
          {t.crafted} <span class="text-brand-primary animate-pulse">🐨</span> by Koko Team
        </span>
        <div class="h-3 w-px bg-border-subtle/40 hidden sm:block"></div>
        <a href="#" class="hover:text-text-main transition-colors">{t.privacy}</a>
        <a href="#" class="hover:text-text-main transition-colors">{t.terms}</a>
      </div>

    </div>
  </div>
</footer>