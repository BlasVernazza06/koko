---
import Header from '@/components/header/header.astro';
import '@/styles/global.css';
import 'lenis/dist/lenis.css';

interface Props {
  lang?: string;
  title?: string;
  description?: string;
  revealHeaderOnScroll?: boolean;
}

const { lang = 'es', title, description, revealHeaderOnScroll = false } = Astro.props;

const defaultTitle = lang === 'es' ? 'Koko — CLI de inicialización de proyectos ultra rápido' : 'Koko — Ultra fast project scaffolding CLI';
const defaultDesc = lang === 'es' 
  ? 'Koko es un motor de scaffolding escrito en Go que elimina la fricción de configuración y te ayuda a evolucionar tu arquitectura sin problemas.' 
  : 'Koko is a Go-powered developer ergonomics CLI designed to eliminate setup friction and seamlessly evolve your stack.';

const metaTitle = title || defaultTitle;
const metaDesc = description || defaultDesc;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

const pathname = Astro.url.pathname;
const siteOrigin = Astro.site || Astro.url.origin;
const cleanPath = pathname.replace(/^\/en/, '').replace(/\/$/, '') || '/';
const isHome = cleanPath === '/';
const esAlternateURL = new URL(cleanPath, siteOrigin);
const enAlternateURL = new URL(cleanPath === '/' ? '/en' : `/en${cleanPath}`, siteOrigin);
const ogImageURL = new URL('/logo.png', siteOrigin).href;

const schemaData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteOrigin}/#website`,
			"url": siteOrigin.toString(),
			"name": "Koko CLI",
			"description": defaultDesc,
			"inLanguage": [lang, lang === 'es' ? 'en' : 'es']
		},
		{
			"@type": "SoftwareApplication",
			"@id": `${siteOrigin}/#software`,
			"name": "Koko",
			"applicationCategory": "DeveloperApplication",
			"operatingSystem": "Linux, macOS, Windows",
			"description": metaDesc,
			"url": siteOrigin.toString(),
			"image": ogImageURL,
			"sameAs": [
				"https://github.com/BlasVernazza06/koko"
			],
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			}
		}
	]
};
---
<!doctype html>
<html lang={lang} data-lang={lang} data-is-home={isHome ? "true" : "false"} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Preconnect and Load Google Sans Fonts (SpaceFS Typography) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&family=Google+Sans+Code:wght@400;500;600&display=swap" />

		<!-- Preload critical local fonts for zero-latency rendering (No FOUT / No layout shift) -->
		<link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{metaTitle}</title>
		<meta name="title" content={metaTitle} />
		<meta name="description" content={metaDesc} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es" href={esAlternateURL.href} />
		<link rel="alternate" hreflang="en" href={enAlternateURL.href} />
		<link rel="alternate" hreflang="x-default" href={esAlternateURL.href} />
		<meta name="robots" content="index, follow" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={metaTitle} />
		<meta property="og:description" content={metaDesc} />
		<meta property="og:image" content={ogImageURL} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={metaTitle} />
		<meta property="twitter:description" content={metaDesc} />
		<meta property="twitter:image" content={ogImageURL} />

		<!-- Structured Data (JSON-LD) for Search Engines -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
		<script is:inline>
			document.documentElement.classList.add('js');
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			})();
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
				document.documentElement.setAttribute('data-theme', 'light');
			} else {
				document.documentElement.classList.add('dark');
				document.documentElement.setAttribute('data-theme', 'dark');
			}
		</script>
		<script>
			import '../../sentry.client.config.js';
			import Lenis from 'lenis';

			let lenisInstance: Lenis | null = null;

			function setupSmoothScroll() {
				if (typeof window === 'undefined') return;

				// Respect user preference for reduced motion
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					return;
				}

				if (lenisInstance) {
					lenisInstance.destroy();
				}

				lenisInstance = new Lenis({
					autoRaf: true,
					duration: 1.2,
					smoothWheel: true,
					touchMultiplier: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
				});

				(window as any).__lenis = lenisInstance;

				// Smooth scrolling for internal anchor links (#features, #docs, etc.)
				document.querySelectorAll('a[href*="#"]').forEach((anchor) => {
					anchor.addEventListener('click', (e) => {
						const href = anchor.getAttribute('href');
						if (!href) return;
						const hashIndex = href.indexOf('#');
						if (hashIndex === -1) return;
						const hash = href.slice(hashIndex);
						if (hash.length > 1) {
							const target = document.querySelector(hash);
							if (target) {
								e.preventDefault();
								lenisInstance?.scrollTo(target as HTMLElement, { offset: -70, duration: 1.2 });
							}
						}
					});
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', setupSmoothScroll);
			} else {
				setupSmoothScroll();
			}

			document.addEventListener('astro:before-swap', () => {
				lenisInstance?.destroy();
				lenisInstance = null;
			});
			document.addEventListener('astro:after-swap', setupSmoothScroll);
		</script>
	</head>
	<body class="antialiased scroll-smooth">
		<Header revealOnScroll={revealHeaderOnScroll} />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
